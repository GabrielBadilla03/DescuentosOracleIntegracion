@{
    var autenticado =
        User.Identity?.IsAuthenticated == true;

    var inicioController =
        autenticado
            ? "TomaFisica"
            : "Account";

    var inicioAction =
        autenticado
            ? "Menu"
            : "Login";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Toma Física
    </title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/TomaFisica.styles.css"
          asp-append-version="true" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />
</head>

<body>

    <header>
        <nav class="navbar navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-controller="@inicioController"
                   asp-action="@inicioAction">

                    <img src="~/imagenes/lanco.png"
                         alt="Lanco"
                         style="height: 50px; width: auto;" />
                </a>

                @if (autenticado)
                {
                    <form method="post"
                          asp-controller="Account"
                          asp-action="Logout"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-sm btn-danger">
                            Cerrar Sesión
                        </button>

                    </form>
                }

            </div>

        </nav>
    </header>

    <div class="container">
        <main role="main"
              class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>
</html>
