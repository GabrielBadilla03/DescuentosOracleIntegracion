@{
    ViewData["Title"] = "Conteo Toma Física";
}

<style>
    .toma-page {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto 24px auto;
        padding: 0 4px;
    }

    .toma-card {
        border: 1px solid #dee2e6;
        border-radius: 7px;
        box-shadow: 0 2px 8px rgba(0,0,0,.05);
        margin-bottom: 8px;
    }

        .toma-card .card-body {
            padding: 10px;
        }

    .toma-ventanas {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 4px;
        margin-bottom: 7px;
    }

    .toma-ventana-btn {
        min-height: 38px;
        padding: 6px;
        border: 1px solid #dc3545;
        border-radius: 4px;
        background: #fff;
        color: #dc3545;
        font-size: .8rem;
        font-weight: 700;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .toma-ventana-btn.activo,
        .toma-ventana-btn:hover,
        .toma-ventana-btn:focus {
            background: #dc3545;
            color: #fff;
        }

    .campo-label {
        display: block;
        margin-bottom: 3px;
        color: #495057;
        font-size: .68rem;
        font-weight: 700;
    }

    .form-control,
    .form-select {
        min-height: 39px;
        font-size: 16px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0,1fr));
        gap: 4px;
        margin-top: 7px;
    }

    .info-item {
        padding: 5px 6px;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        background: #f8f9fa;
        min-width: 0;
    }

    .info-label {
        color: #6c757d;
        font-size: .6rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .info-value {
        margin-top: 2px;
        font-size: .76rem;
        font-weight: 700;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .captura-principal {
        display: grid;
        grid-template-columns: minmax(110px,.8fr) minmax(180px,1.6fr);
        gap: 5px;
        align-items: end;
    }

    .captura-secundaria {
        display: grid;
        grid-template-columns: minmax(95px,.65fr) minmax(150px,1fr) minmax(160px,1.15fr);
        gap: 5px;
        align-items: end;
        margin-top: 5px;
    }

    .descripcion-articulo {
        margin-top: 5px;
        padding: 6px;
        min-height: 36px;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        background: #f8f9fa;
        font-size: .76rem;
    }

    .meta-articulo {
        margin-top: 3px;
        color: #6c757d;
        font-size: .66rem;
    }

    .mensaje {
        min-height: 0;
        margin-top: 6px;
        font-size: .74rem;
        font-weight: 600;
    }

        .mensaje:empty {
            display: none;
        }

        .mensaje.ok {
            color: #198754;
        }

        .mensaje.error {
            color: #dc3545;
        }

    .captura-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 6px;
        margin-bottom: 6px;
    }

    .instruccion {
        color: #6c757d;
        font-size: .7rem;
    }

    .btn-guardar {
        min-height: 30px;
        padding: 4px 8px;
        font-weight: 700;
        font-size: .72rem;
    }

    .ultimos-lista,
    .consulta-lista {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-top: 5px;
    }

    .ultimo-item {
        display: grid;
        grid-template-columns: minmax(90px,.8fr) minmax(145px,1.3fr) minmax(70px,.6fr);
        gap: 6px;
        padding: 7px 8px;
        border: 1px solid #e5e7eb;
        border-radius: 4px;
        font-size: .88rem;
        line-height: 1.25;
    }

        .ultimo-item .cantidad {
            text-align: right;
            font-weight: 800;
            font-size: .95rem;
        }

    #ultimosContenedor > .small {
        font-size: .84rem !important;
    }

    .consulta-filtros {
        display: grid;
        grid-template-columns: minmax(110px,.8fr) minmax(180px,1.6fr);
        gap: 5px;
        align-items: end;
    }

    .consulta-acciones {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5px;
        margin-top: 6px;
    }

    .consulta-item {
        padding: 7px;
        border: 1px solid #dee2e6;
        border-radius: 5px;
        background: #fff;
    }

    .consulta-cabecera {
        display: grid;
        grid-template-columns: minmax(80px,.7fr) minmax(120px,1.2fr) auto;
        gap: 5px;
        align-items: center;
    }

    .consulta-localiza,
    .consulta-articulo {
        font-weight: 700;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .consulta-localiza {
        font-size: .68rem;
    }

    .consulta-articulo {
        font-size: .76rem;
    }

    .consulta-descripcion,
    .consulta-extra {
        margin-top: 3px;
        color: #6c757d;
        font-size: .66rem;
    }

    .consulta-conteos {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 4px;
        margin-top: 5px;
    }

    .consulta-conteo {
        padding: 4px;
        border: 1px solid #e5e7eb;
        border-radius: 3px;
        background: #f8f9fa;
        text-align: center;
    }

        .consulta-conteo.activo {
            border-color: #dc3545;
            background: #fff5f5;
        }

    .consulta-conteo-label {
        color: #6c757d;
        font-size: .58rem;
        font-weight: 700;
    }

    .consulta-conteo-valor {
        font-size: .78rem;
        font-weight: 700;
    }

    .d-none-forzada {
        display: none !important;
    }

    @@media (max-width: 767.98px) {
        .toma-page {
            padding: 0 1px;
            margin-bottom: 12px;
        }

        .toma-card .card-body {
            padding: 6px 4px;
        }

        .toma-ventana-btn {
            font-size: .69rem;
            padding: 5px 2px;
        }

        .info-grid {
            grid-template-columns: 1fr 1fr;
            gap: 3px;
        }

        .captura-principal,
        .consulta-filtros {
            gap: 3px;
        }

        .captura-secundaria {
            grid-template-columns: minmax(75px,.55fr) minmax(120px,.9fr) minmax(125px,1fr);
            gap: 3px;
        }

        .campo-label {
            font-size: .61rem;
        }

        .consulta-item {
            padding: 5px;
        }

        .consulta-cabecera {
            grid-template-columns: minmax(65px,.65fr) minmax(100px,1fr) auto;
            gap: 3px;
        }
    }

    @@media (max-width: 430px) {
        .captura-principal,
        .consulta-filtros {
            grid-template-columns: minmax(90px,.72fr) minmax(145px,1.28fr);
        }

        .captura-secundaria {
            grid-template-columns: 1fr 1fr;
        }

            .captura-secundaria > div:last-child {
                grid-column: 1 / -1;
            }
    }
</style>

<div class="toma-page">
    <h2 class="h5 mb-2">Conteo Toma Física</h2>

    <div class="toma-ventanas" id="botonesModo">
        <button type="button" class="toma-ventana-btn activo" data-modo="1">Conteo 1</button>
        <button type="button" class="toma-ventana-btn" data-modo="2">Conteo 2</button>
        <button type="button" class="toma-ventana-btn" data-modo="3">Verificación</button>
    </div>

    <div class="toma-ventanas">
        <button type="button" id="btnCapturar" class="toma-ventana-btn activo">Capturar</button>
        <button type="button" id="btnConsultar" class="toma-ventana-btn">Consultar</button>
        <a asp-controller="TomaFisica" asp-action="Menu" class="toma-ventana-btn">Volver</a>
    </div>

    <form id="formToken" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <div class="card toma-card">
        <div class="card-body">
            <label for="selectToma" class="campo-label">Toma física</label>
            <select id="selectToma" class="form-select">
                <option value="">Cargando tomas...</option>
            </select>

            <div id="mensajeToma" class="mensaje"></div>

            <div id="infoToma" class="info-grid d-none-forzada">
                <div class="info-item">
                    <div class="info-label">Secuencia</div>
                    <div id="infoSecuencia" class="info-value"></div>
                </div>
                <div class="info-item">
                    <div class="info-label">Bodega</div>
                    <div id="infoBodega" class="info-value"></div>
                </div>
                <div class="info-item">
                    <div class="info-label">Tipo / Estado</div>
                    <div id="infoTipo" class="info-value"></div>
                </div>
                <div class="info-item">
                    <div class="info-label">Observación</div>
                    <div id="infoObservacion" class="info-value"></div>
                </div>
            </div>
        </div>
    </div>

    <div id="panelCapturar">
        <div id="cardCaptura" class="card toma-card d-none-forzada">
            <div class="card-body">
                <div class="captura-top">
                    <div class="instruccion">
                        Localización → artículo/código de barras → cantidad. Origen y batch son opcionales.
                    </div>
                    <span id="contadorGuardados" class="badge bg-success">Guardados: 0</span>
                </div>

                <div class="captura-principal">
                    <div>
                        <label for="localiza" class="campo-label">Localización</label>
                        <input id="localiza"
                               type="text"
                               maxlength="15"
                               class="form-control text-uppercase"
                               autocomplete="off"
                               autocapitalize="characters"
                               spellcheck="false"
                               placeholder="Localización" />
                    </div>
                    <div>
                        <label for="codigo" class="campo-label">Artículo / Código de barras</label>
                        <input id="codigo"
                               type="text"
                               maxlength="100"
                               class="form-control"
                               autocomplete="off"
                               spellcheck="false"
                               placeholder="Escanee o digite" />
                    </div>
                </div>

                <div id="descripcionArticulo" class="descripcion-articulo text-muted">
                    Escanee un artículo o código de barras.
                </div>
                <div id="metaArticulo" class="meta-articulo"></div>

                <div class="captura-secundaria">
                    <div>
                        <label for="cantidad" class="campo-label">Cantidad</label>
                        <input id="cantidad"
                               type="text"
                               inputmode="decimal"
                               class="form-control"
                               autocomplete="off"
                               placeholder="0" />
                    </div>
                    <div>
                        <label for="origen" class="campo-label">Origen (opcional)</label>
                        <select id="origen" class="form-select">
                            <option value="">Sin origen</option>
                        </select>
                    </div>
                    <div>
                        <label for="batch" class="campo-label">Batch (opcional)</label>
                        <input id="batch"
                               type="text"
                               maxlength="30"
                               class="form-control text-uppercase"
                               autocomplete="off"
                               autocapitalize="characters"
                               spellcheck="false"
                               placeholder="Batch" />
                    </div>
                </div>

                <button id="btnGuardar" type="button" class="btn btn-danger btn-guardar">
                    Guardar conteo
                </button>

                <div id="mensajeCaptura" class="mensaje"></div>

                <div id="ultimosContenedor" class="d-none-forzada mt-2">
                    <div class="small fw-bold text-muted">Capturas de esta sesión</div>
                    <div id="ultimosLista" class="ultimos-lista"></div>
                </div>
            </div>
        </div>
    </div>

    <div id="panelConsultar" class="d-none-forzada">
        <div class="card toma-card">
            <div class="card-body">
                <div class="instruccion mb-2">
                    Filtre por localización, artículo o código de barras. Sin filtros se muestran hasta 200 registros.
                </div>

                <div class="consulta-filtros">
                    <div>
                        <label for="consultaLocaliza" class="campo-label">Localización</label>
                        <input id="consultaLocaliza"
                               type="text"
                               maxlength="15"
                               class="form-control text-uppercase"
                               autocomplete="off"
                               placeholder="Opcional" />
                    </div>
                    <div>
                        <label for="consultaCodigo" class="campo-label">Artículo / Código de barras</label>
                        <input id="consultaCodigo"
                               type="text"
                               maxlength="100"
                               class="form-control"
                               autocomplete="off"
                               placeholder="Opcional" />
                    </div>
                </div>

                <div class="consulta-acciones">
                    <button id="btnBuscar" type="button" class="btn btn-danger">Consultar</button>
                    <button id="btnLimpiar" type="button" class="btn btn-outline-secondary">Limpiar</button>
                </div>

                <div id="mensajeConsulta" class="mensaje"></div>

                <div id="resultadoConsulta" class="d-none-forzada mt-2">
                    <div id="tituloResultado" class="small fw-bold text-muted"></div>
                    <div id="listaConteos" class="consulta-lista"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const urlListarTomas = '@Url.Action("ListarTomas", "ConteoTomaFisica")';
            const urlCargarToma = '@Url.Action("CargarToma", "ConteoTomaFisica")';
            const urlResolverArticulo = '@Url.Action("ResolverArticulo", "ConteoTomaFisica")';
            const urlGuardarConteo = '@Url.Action("GuardarConteo", "ConteoTomaFisica")';
            const urlConsultarConteos = '@Url.Action("ConsultarConteos", "ConteoTomaFisica")';
            const urlEliminarConteo = '@Url.Action("EliminarConteo", "ConteoTomaFisica")';

            const token = document.querySelector('#formToken input[name="__RequestVerificationToken"]')?.value ?? '';
            const botonesModo = Array.from(document.querySelectorAll('[data-modo]'));
            const btnCapturar = document.getElementById('btnCapturar');
            const btnConsultar = document.getElementById('btnConsultar');
            const selectToma = document.getElementById('selectToma');
            const mensajeToma = document.getElementById('mensajeToma');
            const infoToma = document.getElementById('infoToma');
            const cardCaptura = document.getElementById('cardCaptura');
            const panelCapturar = document.getElementById('panelCapturar');
            const panelConsultar = document.getElementById('panelConsultar');

            const localiza = document.getElementById('localiza');
            const codigo = document.getElementById('codigo');
            const cantidad = document.getElementById('cantidad');
            const origen = document.getElementById('origen');
            const batch = document.getElementById('batch');
            const btnGuardar = document.getElementById('btnGuardar');
            const mensajeCaptura = document.getElementById('mensajeCaptura');
            const descripcionArticulo = document.getElementById('descripcionArticulo');
            const metaArticulo = document.getElementById('metaArticulo');
            const contadorGuardados = document.getElementById('contadorGuardados');
            const ultimosContenedor = document.getElementById('ultimosContenedor');
            const ultimosLista = document.getElementById('ultimosLista');

            const consultaLocaliza = document.getElementById('consultaLocaliza');
            const consultaCodigo = document.getElementById('consultaCodigo');
            const btnBuscar = document.getElementById('btnBuscar');
            const btnLimpiar = document.getElementById('btnLimpiar');
            const mensajeConsulta = document.getElementById('mensajeConsulta');
            const resultadoConsulta = document.getElementById('resultadoConsulta');
            const tituloResultado = document.getElementById('tituloResultado');
            const listaConteos = document.getElementById('listaConteos');

            let modo = '1';
            let secuencia = 0;
            let articuloResuelto = '';
            let guardando = false;
            let totalGuardados = 0;

            function mostrarMensaje(elemento, texto, clase = '') {
                elemento.textContent = texto ?? '';
                elemento.className = 'mensaje';
                if (clase) elemento.classList.add(clase);
            }

            async function leerJson(response) {
                try { return await response.json(); }
                catch { return null; }
            }

            function errorServidor(data, porDefecto) {
                if (!data) return porDefecto;
                if (data.detalle) return `${data.mensaje ?? porDefecto} ${data.detalle}`;
                return data.mensaje ?? porDefecto;
            }

            function nombreModo() {
                if (modo === '1') return 'Conteo 1';
                if (modo === '2') return 'Conteo 2';
                return 'Verificación';
            }

            function valorVisible(valor) {
                return valor === null || valor === undefined || valor === ''
                    ? '-'
                    : valor;
            }

            function ponerModoActivo() {
                for (const boton of botonesModo) {
                    boton.classList.toggle('activo', boton.dataset.modo === modo);
                }
            }

            function limpiarArticulo() {
                articuloResuelto = '';
                codigo.value = '';
                cantidad.value = '';
                origen.value = '';
                batch.value = '';
                descripcionArticulo.textContent = 'Escanee un artículo o código de barras.';
                descripcionArticulo.classList.add('text-muted');
                metaArticulo.textContent = '';
                mostrarMensaje(mensajeCaptura, '');
            }

            function limpiarTomaSeleccionada() {
                secuencia = 0;
                infoToma.classList.add('d-none-forzada');
                cardCaptura.classList.add('d-none-forzada');
                document.getElementById('infoSecuencia').textContent = '';
                document.getElementById('infoBodega').textContent = '';
                document.getElementById('infoTipo').textContent = '';
                document.getElementById('infoObservacion').textContent = '';
                origen.innerHTML = '<option value="">Sin origen</option>';
                localiza.value = '';
                limpiarArticulo();
                resultadoConsulta.classList.add('d-none-forzada');
                listaConteos.innerHTML = '';
            }

            function cargarOrigenes(origenes) {
                origen.innerHTML = '<option value="">Sin origen</option>';

                for (const item of (origenes ?? [])) {
                    if (item.origen === null || item.origen === undefined) continue;
                    const option = document.createElement('option');
                    option.value = item.origen.toString();
                    option.textContent = item.descripcion
                        ? `${item.origen} - ${item.descripcion}`
                        : item.origen.toString();
                    origen.appendChild(option);
                }
            }

            async function cargarListaTomas() {
                limpiarTomaSeleccionada();
                selectToma.disabled = true;
                selectToma.innerHTML = '<option value="">Cargando tomas...</option>';
                mostrarMensaje(mensajeToma, '');

                try {
                    const response = await fetch(
                        `${urlListarTomas}?modo=${encodeURIComponent(modo)}`,
                        { headers: { 'Accept': 'application/json' } });
                    const data = await leerJson(response);

                    if (!response.ok || data?.ok !== true) {
                        throw new Error(errorServidor(data, 'No fue posible cargar las tomas.'));
                    }

                    selectToma.innerHTML = '<option value="">Seleccione una toma física</option>';

                    for (const toma of (data.tomas ?? [])) {
                        const option = document.createElement('option');
                        option.value = toma.secuencia ?? '';
                        const bodega = toma.desBodega
                            ? `${toma.codBodega} - ${toma.desBodega}`
                            : (toma.codBodega ?? '');
                        option.textContent = `${toma.secuencia} | ${bodega} | Tipo ${toma.tipo ?? ''}`;
                        selectToma.appendChild(option);
                    }

                    if (!(data.tomas ?? []).length) {
                        mostrarMensaje(
                            mensajeToma,
                            data.mensaje ?? `No hay tomas disponibles para ${nombreModo()}.`,
                            'error');
                    }

                    selectToma.disabled = false;
                }
                catch (error) {
                    selectToma.innerHTML = '<option value="">Sin tomas</option>';
                    mostrarMensaje(mensajeToma, error?.message ?? 'No fue posible cargar las tomas.', 'error');
                }
                finally {
                    selectToma.disabled = false;
                }
            }

            async function cargarToma() {
                const valor = Number.parseInt(selectToma.value, 10);

                if (!Number.isFinite(valor) || valor <= 0) {
                    limpiarTomaSeleccionada();
                    return;
                }

                secuencia = valor;
                cardCaptura.classList.add('d-none-forzada');
                infoToma.classList.add('d-none-forzada');
                mostrarMensaje(mensajeToma, 'Cargando toma...');

                try {
                    const response = await fetch(
                        `${urlCargarToma}?secuencia=${encodeURIComponent(secuencia)}&modo=${encodeURIComponent(modo)}`,
                        { headers: { 'Accept': 'application/json' } });
                    const data = await leerJson(response);

                    if (!response.ok || data?.ok !== true) {
                        throw new Error(errorServidor(data, 'No fue posible cargar la toma.'));
                    }

                    const toma = data.toma ?? {};
                    document.getElementById('infoSecuencia').textContent = toma.secuencia ?? '';
                    document.getElementById('infoBodega').textContent =
                        `${toma.codBodega ?? ''}${toma.desBodega ? ` - ${toma.desBodega}` : ''}`;
                    document.getElementById('infoTipo').textContent =
                        `Tipo ${toma.tipo ?? ''} / ${toma.estado ?? ''}`;
                    document.getElementById('infoObservacion').textContent = toma.observacion || '-';

                    cargarOrigenes(data.origenes);
                    infoToma.classList.remove('d-none-forzada');
                    cardCaptura.classList.remove('d-none-forzada');
                    mostrarMensaje(
                        mensajeToma,
                        `${nombreModo()} listo. Registros visibles: ${toma.detallesVisibles ?? 0}.`,
                        'ok');

                    localiza.focus();
                }
                catch (error) {
                    limpiarTomaSeleccionada();
                    selectToma.value = '';
                    mostrarMensaje(mensajeToma, error?.message ?? 'No fue posible cargar la toma.', 'error');
                }
            }

            async function resolverArticulo() {
                if (!secuencia) {
                    mostrarMensaje(mensajeCaptura, 'Seleccione una toma física.', 'error');
                    return false;
                }

                const loc = localiza.value.trim().toUpperCase();
                const cod = codigo.value.trim();

                if (!loc) {
                    mostrarMensaje(mensajeCaptura, 'Digite la localización.', 'error');
                    localiza.focus();
                    return false;
                }

                if (!cod) {
                    mostrarMensaje(mensajeCaptura, 'Escanee o digite el artículo.', 'error');
                    codigo.focus();
                    return false;
                }

                localiza.value = loc;
                codigo.disabled = true;
                mostrarMensaje(mensajeCaptura, 'Validando artículo...');

                try {
                    const url = `${urlResolverArticulo}` +
                        `?secuencia=${encodeURIComponent(secuencia)}` +
                        `&modo=${encodeURIComponent(modo)}` +
                        `&localiza=${encodeURIComponent(loc)}` +
                        `&codigo=${encodeURIComponent(cod)}`;

                    const response = await fetch(url, { headers: { 'Accept': 'application/json' } });
                    const data = await leerJson(response);

                    if (!response.ok || data?.ok !== true) {
                        throw new Error(errorServidor(data, 'No se pudo validar el artículo.'));
                    }

                    articuloResuelto = data.codigoArticulo ?? '';
                    codigo.value = articuloResuelto;
                    descripcionArticulo.classList.remove('text-muted');
                    descripcionArticulo.textContent =
                        `${articuloResuelto}${data.descripcion ? ` - ${data.descripcion}` : ''}`;

                    const meta = [];
                    if (data.medida) meta.push(`Medida: ${data.medida}`);
                    meta.push(data.existeDetalle ? 'Registro existente' : 'Nuevo registro');
                    if (data.conteoActual !== null && data.conteoActual !== undefined) {
                        meta.push(`Conteo actual: ${data.conteoActual}`);
                    }
                    if (data.desOrigen) meta.push(`Origen: ${data.desOrigen}`);
                    metaArticulo.textContent = meta.join(' · ');

                    if (data.cantidadEscaneada !== null && data.cantidadEscaneada !== undefined) {
                        cantidad.value = data.cantidadEscaneada;
                    }
                    else if (data.conteoActual !== null && data.conteoActual !== undefined) {
                        cantidad.value = data.conteoActual;
                    }
                    else {
                        cantidad.value = '';
                    }

                    origen.value = data.origen === null || data.origen === undefined
                        ? ''
                        : data.origen.toString();
                    batch.value = data.batch ?? '';

                    mostrarMensaje(mensajeCaptura, 'Artículo válido.', 'ok');
                    cantidad.focus();
                    cantidad.select();
                    return true;
                }
                catch (error) {
                    articuloResuelto = '';
                    descripcionArticulo.textContent = 'Escanee un artículo o código de barras.';
                    descripcionArticulo.classList.add('text-muted');
                    metaArticulo.textContent = '';
                    mostrarMensaje(mensajeCaptura, error?.message ?? 'No se pudo validar el artículo.', 'error');
                    codigo.focus();
                    codigo.select();
                    return false;
                }
                finally {
                    codigo.disabled = false;
                }
            }

            function agregarUltimo(data) {
                const row = document.createElement('div');
                row.className = 'ultimo-item';

                const loc = document.createElement('div');
                loc.textContent = data.localiza ?? '';
                const art = document.createElement('div');
                art.textContent = data.codigoArticulo ?? '';
                const cant = document.createElement('div');
                cant.className = 'cantidad';
                cant.textContent = data.cantidad ?? '';

                row.append(loc, art, cant);
                ultimosLista.prepend(row);

                while (ultimosLista.children.length > 8) {
                    ultimosLista.lastElementChild?.remove();
                }

                ultimosContenedor.classList.remove('d-none-forzada');
            }

            async function guardarConteo() {
                if (guardando) return;

                if (!secuencia) {
                    mostrarMensaje(mensajeCaptura, 'Seleccione una toma física.', 'error');
                    return;
                }

                if (!articuloResuelto) {
                    const valido = await resolverArticulo();
                    if (!valido) return;
                }

                const loc = localiza.value.trim().toUpperCase();
                const cod = codigo.value.trim();
                const cant = cantidad.value.trim();
                const origenValor = origen.value.trim();
                const batchValor = batch.value.trim().toUpperCase();

                if (!cant) {
                    mostrarMensaje(mensajeCaptura, 'Digite la cantidad.', 'error');
                    cantidad.focus();
                    return;
                }

                guardando = true;
                btnGuardar.disabled = true;
                mostrarMensaje(mensajeCaptura, 'Guardando conteo...');

                const formData = new FormData();
                formData.append('__RequestVerificationToken', token);
                formData.append('secuencia', secuencia.toString());
                formData.append('modo', modo);
                formData.append('localiza', loc);
                formData.append('codigo', cod);
                formData.append('cantidad', cant);
                formData.append('origen', origenValor);
                formData.append('batch', batchValor);

                try {
                    const response = await fetch(urlGuardarConteo, {
                        method: 'POST',
                        body: formData,
                        headers: { 'Accept': 'application/json' }
                    });
                    const data = await leerJson(response);

                    if (!response.ok || data?.ok !== true) {
                        throw new Error(errorServidor(data, 'No se pudo guardar el conteo.'));
                    }

                    totalGuardados++;
                    contadorGuardados.textContent = `Guardados: ${totalGuardados}`;
                    agregarUltimo(data);
                    mostrarMensaje(
                        mensajeCaptura,
                        `${data.mensaje ?? 'Conteo guardado.'} ${data.codigoArticulo ?? ''} = ${data.cantidad ?? ''}`,
                        'ok');

                    articuloResuelto = '';
                    codigo.value = '';
                    cantidad.value = '';
                    origen.value = '';
                    batch.value = '';
                    descripcionArticulo.textContent = 'Escanee un artículo o código de barras.';
                    descripcionArticulo.classList.add('text-muted');
                    metaArticulo.textContent = '';
                    codigo.focus();
                }
                catch (error) {
                    mostrarMensaje(mensajeCaptura, error?.message ?? 'No se pudo guardar el conteo.', 'error');
                }
                finally {
                    guardando = false;
                    btnGuardar.disabled = false;
                }
            }

            function crearConteo(etiqueta, valor, activo) {
                const c = document.createElement('div');
                c.className = `consulta-conteo${activo ? ' activo' : ''}`;

                const l = document.createElement('div');
                l.className = 'consulta-conteo-label';
                l.textContent = etiqueta;

                const v = document.createElement('div');
                v.className = 'consulta-conteo-valor';
                v.textContent = valorVisible(valor);

                c.append(l, v);
                return c;
            }

            function renderizarConteos(data) {
                listaConteos.innerHTML = '';
                const filas = data.filas ?? [];
                tituloResultado.textContent =
                    `${nombreModo()} · Registros: ${filas.length}${data.limitado ? ' · Máximo 200' : ''}`;

                if (!filas.length) {
                    const vacio = document.createElement('div');
                    vacio.className = 'text-muted small border rounded p-2 text-center';
                    vacio.textContent = 'No se encontraron conteos con los filtros indicados.';
                    listaConteos.appendChild(vacio);
                    resultadoConsulta.classList.remove('d-none-forzada');
                    return;
                }

                for (const fila of filas) {
                    const item = document.createElement('div');
                    item.className = 'consulta-item';

                    const cabecera = document.createElement('div');
                    cabecera.className = 'consulta-cabecera';

                    const loc = document.createElement('div');
                    loc.className = 'consulta-localiza';
                    loc.textContent = fila.localiza ?? '';

                    const art = document.createElement('div');
                    art.className = 'consulta-articulo';
                    art.textContent = fila.codigoArticulo ?? '';

                    const eliminar = document.createElement('button');
                    eliminar.type = 'button';
                    eliminar.className = 'btn btn-outline-danger btn-sm';
                    eliminar.textContent = modo === '1'
                        ? 'Eliminar C1'
                        : modo === '2'
                            ? 'Eliminar C2'
                            : 'Eliminar Verif.';
                    eliminar.disabled = fila.puedeEliminar !== true;
                    eliminar.addEventListener('click', () => eliminarConteo(fila));

                    cabecera.append(loc, art, eliminar);

                    const descripcion = document.createElement('div');
                    descripcion.className = 'consulta-descripcion';
                    descripcion.textContent = fila.descripcion || '-';

                    const conteos = document.createElement('div');
                    conteos.className = 'consulta-conteos';
                    conteos.append(
                        crearConteo('Conteo 1', fila.conteo1, modo === '1'),
                        crearConteo('Conteo 2', fila.conteo2, modo === '2'),
                        crearConteo('Verificación', fila.conteo3, modo === '3'));

                    const extra = document.createElement('div');
                    extra.className = 'consulta-extra';
                    const extras = [];

                    if (fila.origen !== null && fila.origen !== undefined) {
                        extras.push(
                            fila.desOrigen
                                ? `Origen: ${fila.origen} - ${fila.desOrigen}`
                                : `Origen: ${fila.origen}`);
                    }

                    if (fila.batch) extras.push(`Batch: ${fila.batch}`);
                    if (fila.fechaLote) extras.push(`Fecha lote: ${new Date(fila.fechaLote).toLocaleDateString()}`);
                    extra.textContent = extras.length ? extras.join(' · ') : 'Sin origen / batch';

                    item.append(cabecera, descripcion, conteos, extra);
                    listaConteos.appendChild(item);
                }

                resultadoConsulta.classList.remove('d-none-forzada');
            }

            async function consultarConteos() {
                if (!secuencia) {
                    mostrarMensaje(mensajeConsulta, 'Seleccione una toma física.', 'error');
                    resultadoConsulta.classList.add('d-none-forzada');
                    return;
                }

                const loc = consultaLocaliza.value.trim().toUpperCase();
                const cod = consultaCodigo.value.trim();
                mostrarMensaje(mensajeConsulta, 'Consultando...');
                resultadoConsulta.classList.add('d-none-forzada');

                try {
                    const url = `${urlConsultarConteos}` +
                        `?secuencia=${encodeURIComponent(secuencia)}` +
                        `&modo=${encodeURIComponent(modo)}` +
                        `&localiza=${encodeURIComponent(loc)}` +
                        `&codigo=${encodeURIComponent(cod)}`;

                    const response = await fetch(url, { headers: { 'Accept': 'application/json' } });
                    const data = await leerJson(response);

                    if (!response.ok || data?.ok !== true) {
                        throw new Error(errorServidor(data, 'No fue posible consultar los conteos.'));
                    }

                    renderizarConteos(data);
                    mostrarMensaje(
                        mensajeConsulta,
                        data.limitado
                            ? 'Consulta completada. Se muestran los primeros 200 registros.'
                            : 'Consulta completada.',
                        'ok');
                }
                catch (error) {
                    listaConteos.innerHTML = '';
                    resultadoConsulta.classList.add('d-none-forzada');
                    mostrarMensaje(mensajeConsulta, error?.message ?? 'No fue posible consultar.', 'error');
                }
            }

            async function eliminarConteo(fila) {
                const etiqueta = nombreModo();
                const articulo = fila.codigoArticulo ?? '';
                const loc = fila.localiza ?? '';

                if (!window.confirm(`¿Eliminar ${etiqueta} de ${articulo} en ${loc}?`)) {
                    return;
                }

                const formData = new FormData();
                formData.append('__RequestVerificationToken', token);
                formData.append('secuencia', secuencia.toString());
                formData.append('modo', modo);
                formData.append('localiza', loc);
                formData.append('codigoArticulo', articulo);

                try {
                    const response = await fetch(urlEliminarConteo, {
                        method: 'POST',
                        body: formData,
                        headers: { 'Accept': 'application/json' }
                    });
                    const data = await leerJson(response);

                    if (!response.ok || data?.ok !== true) {
                        throw new Error(errorServidor(data, 'No fue posible eliminar el conteo.'));
                    }

                    mostrarMensaje(mensajeConsulta, data.mensaje ?? 'Conteo eliminado.', 'ok');
                    await consultarConteos();
                }
                catch (error) {
                    mostrarMensaje(mensajeConsulta, error?.message ?? 'No fue posible eliminar el conteo.', 'error');
                }
            }

            function mostrarVentana(nombre) {
                const capturar = nombre === 'capturar';
                panelCapturar.classList.toggle('d-none-forzada', !capturar);
                panelConsultar.classList.toggle('d-none-forzada', capturar);
                btnCapturar.classList.toggle('activo', capturar);
                btnConsultar.classList.toggle('activo', !capturar);

                if (capturar && secuencia) {
                    localiza.focus();
                }
                else if (!capturar && secuencia) {
                    consultaLocaliza.focus();
                }
            }

            for (const boton of botonesModo) {
                boton.addEventListener('click', async () => {
                    const nuevoModo = boton.dataset.modo;
                    if (!nuevoModo || nuevoModo === modo) return;

                    modo = nuevoModo;
                    ponerModoActivo();
                    totalGuardados = 0;
                    contadorGuardados.textContent = 'Guardados: 0';
                    ultimosLista.innerHTML = '';
                    ultimosContenedor.classList.add('d-none-forzada');
                    await cargarListaTomas();
                });
            }

            btnCapturar.addEventListener('click', () => mostrarVentana('capturar'));
            btnConsultar.addEventListener('click', () => mostrarVentana('consultar'));
            selectToma.addEventListener('change', cargarToma);
            btnGuardar.addEventListener('click', guardarConteo);
            btnBuscar.addEventListener('click', consultarConteos);

            btnLimpiar.addEventListener('click', () => {
                consultaLocaliza.value = '';
                consultaCodigo.value = '';
                resultadoConsulta.classList.add('d-none-forzada');
                listaConteos.innerHTML = '';
                mostrarMensaje(mensajeConsulta, '');
                consultaLocaliza.focus();
            });

            localiza.addEventListener('input', () => {
                localiza.value = localiza.value.toUpperCase();
                limpiarArticulo();
            });

            localiza.addEventListener('keydown', event => {
                if (event.key !== 'Enter') return;
                event.preventDefault();
                codigo.focus();
            });

            codigo.addEventListener('input', () => {
                articuloResuelto = '';
                descripcionArticulo.textContent = 'Escanee un artículo o código de barras.';
                descripcionArticulo.classList.add('text-muted');
                metaArticulo.textContent = '';
            });

            codigo.addEventListener('keydown', async event => {
                if (event.key !== 'Enter') return;
                event.preventDefault();
                await resolverArticulo();
            });

            cantidad.addEventListener('keydown', async event => {
                if (event.key !== 'Enter') return;
                event.preventDefault();
                await guardarConteo();
            });

            batch.addEventListener('keydown', async event => {
                if (event.key !== 'Enter') return;
                event.preventDefault();
                await guardarConteo();
            });

            consultaLocaliza.addEventListener('keydown', event => {
                if (event.key !== 'Enter') return;
                event.preventDefault();
                consultarConteos();
            });

            consultaCodigo.addEventListener('keydown', event => {
                if (event.key !== 'Enter') return;
                event.preventDefault();
                consultarConteos();
            });

            ponerModoActivo();
            mostrarVentana('capturar');
            cargarListaTomas();
        })();
    </script>
}
