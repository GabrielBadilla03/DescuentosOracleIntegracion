@section Scripts {
    <script>
        (() => {
          const modal = document.getElementById('generarExcelModal');
          if (!modal) return;

          let current = 'promocional'; // default SIEMPRE

          function setActive(tipo) {
            const btnPromo = modal.querySelector('#btnFiltroPromo');
            const btnFijo  = modal.querySelector('#btnFiltroFijo');

            btnPromo?.classList.toggle('active', tipo === 'promocional');
            btnFijo?.classList.toggle('active',  tipo === 'fijo');

            // NUEVO: actualizar hidden para el POST
            const hidden = modal.querySelector('#tipoFiltroExcel');
            if (hidden) hidden.value = tipo;
          }

          function applyFilter(tipo) {
            current = tipo;
            setActive(tipo);

            const items = modal.querySelectorAll('.item-solicitud');

            items.forEach(item => {
              const match = item.dataset.tipo === tipo;
              item.classList.toggle('d-none', !match);

              const cb = item.querySelector('input[type="checkbox"]');
              if (cb) {
                if (!match) {
                  cb.checked = false;  // evita mezclar
                  cb.disabled = true;  // no se envía
                } else {
                  cb.disabled = false;
                }
              }
            });
          }

          modal.querySelector('#btnFiltroPromo')?.addEventListener('click', () => applyFilter('promocional'));
          modal.querySelector('#btnFiltroFijo')?.addEventListener('click', () => applyFilter('fijo'));

          modal.addEventListener('show.bs.modal', () => applyFilter('promocional'));
        })();


        (() => {
          const txt = document.getElementById('txtClienteFiltro');
          const sel = document.getElementById('selClientes');
          if (!txt || !sel) return;

          const urlBuscar = '@Url.Action("BuscarClientes", "Predescuentos")';

          let t = null;

          function setLoading() {
            // Mantener opción seleccionada si existiera
            const current = sel.value;
            sel.innerHTML = '<option value="">Buscando...</option>';
            if (current) {
              const opt = document.createElement('option');
              opt.value = current;
              opt.textContent = current;
              sel.appendChild(opt);
              sel.value = current;
            }
          }

          function renderResults(data) {
            const current = sel.value; // por si ya había seleccionado

            sel.innerHTML = '<option value="">-- Seleccione un cliente --</option>';

            if (!Array.isArray(data) || data.length === 0) {
              const opt = document.createElement('option');
              opt.value = '';
              opt.textContent = 'Sin resultados';
              sel.appendChild(opt);
              return;
            }

            data.forEach(x => {
              const cod = x.codCliente || x.CodCliente;
              const nom = x.nomCliente || x.NomCliente;

              if (!cod) return;

              const opt = document.createElement('option');
              opt.value = cod;
              opt.textContent = nom ? `${nom} (${cod})` : cod;
              sel.appendChild(opt);
            });

            // Restaurar selección si todavía existe
            if (current) sel.value = current;
          }

          async function buscar() {
            const q = (txt.value || '').trim();
            if (q.length < 2) {
              // Si querés, podés limpiar solo si no hay selección
              return;
            }

            try {
              setLoading();
              const res = await fetch(`${urlBuscar}?filtro=${encodeURIComponent(q)}`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
              });
              if (!res.ok) throw new Error('HTTP ' + res.status);
              const data = await res.json();
              renderResults(data);
            } catch (e) {
              sel.innerHTML = '<option value="">Error al buscar</option>';
              console.error(e);
            }
          }

          txt.addEventListener('input', () => {
            clearTimeout(t);
            t = setTimeout(buscar, 300); // debounce
          });

          // Extra: si presiona Enter en el input, evita submit (porque todavía no eligió)
          txt.addEventListener('keydown', (ev) => {
            if (ev.key === 'Enter') {
              ev.preventDefault();
              buscar();
            }
          });
        })();

    </script>

    <script>
        (() => {
            const modal = document.getElementById('copiarDescuentosArticuloModal');
            if (!modal) return;

            const form = modal.querySelector('#formCopiarDescuentosArticulo');
            const btnGuardar = modal.querySelector('#btnCopiarDescuentos');
            const mensaje = modal.querySelector('#mensajeCopiarDescuentos');
            const urlBuscarItems = '@Url.Action("BuscarItems", "Predescuentos")';

            function mostrarMensaje(texto, esError = false) {
                if (!mensaje) return;

                mensaje.textContent = texto || '';
                mensaje.classList.toggle('d-none', !texto);
                mensaje.classList.toggle('alert-danger', esError);
                mensaje.classList.toggle('alert-warning', !esError);
            }

            function validarSeleccion() {
                const nuevo = (modal.querySelector('#hidArticuloNuevo')?.value || '').trim();
                const origen = (modal.querySelector('#hidArticuloOrigen')?.value || '').trim();
                const sonIguales = nuevo && origen && nuevo.toUpperCase() === origen.toUpperCase();

                if (btnGuardar) {
                    btnGuardar.disabled = !nuevo || !origen || sonIguales;
                }

                if (sonIguales) {
                    mostrarMensaje('El artículo nuevo y el artículo origen deben ser diferentes.', true);
                } else {
                    mostrarMensaje('');
                }
            }

            function crearBuscador({ inputId, dropdownId, hiddenId, selectedId }) {
                const input = modal.querySelector(inputId);
                const dropdown = modal.querySelector(dropdownId);
                const hidden = modal.querySelector(hiddenId);
                const selected = modal.querySelector(selectedId);

                if (!input || !dropdown || !hidden || !selected) return null;

                let timer = null;
                let requestController = null;

                function ocultarDropdown() {
                    dropdown.classList.remove('show');
                }

                function mostrarEstado(texto) {
                    dropdown.replaceChildren();

                    const item = document.createElement('div');
                    item.className = 'dropdown-item-text text-muted';
                    item.textContent = texto;
                    dropdown.appendChild(item);
                    dropdown.classList.add('show');
                }

                function limpiarSeleccion() {
                    hidden.value = '';
                    selected.textContent = 'Ningún artículo seleccionado.';
                    validarSeleccion();
                }

                function seleccionar(itemNumber, description) {
                    hidden.value = itemNumber;
                    selected.textContent = description
                        ? `${itemNumber} — ${description}`
                        : itemNumber;
                    input.value = description
                        ? `${itemNumber} — ${description}`
                        : itemNumber;
                    ocultarDropdown();
                    validarSeleccion();
                }

                function renderizar(data) {
                    dropdown.replaceChildren();

                    if (!Array.isArray(data) || data.length === 0) {
                        mostrarEstado('No se encontraron artículos.');
                        return;
                    }

                    data.forEach(x => {
                        const itemNumber = x.itemNumber || x.ItemNumber || '';
                        const description = x.description || x.Description || '';

                        if (!itemNumber) return;

                        const button = document.createElement('button');
                        button.type = 'button';
                        button.className = 'dropdown-item py-2 border-bottom text-wrap';

                        const codigo = document.createElement('div');
                        codigo.className = 'fw-bold';
                        codigo.textContent = itemNumber;

                        const descripcion = document.createElement('div');
                        descripcion.className = 'small text-muted';
                        descripcion.textContent = description || 'Sin descripción';

                        button.append(codigo, descripcion);
                        button.addEventListener('click', () => seleccionar(itemNumber, description));
                        dropdown.appendChild(button);
                    });

                    dropdown.classList.add('show');
                }

                async function buscar() {
                    const filtro = (input.value || '').trim();
                    limpiarSeleccion();

                    if (filtro.length < 2) {
                        ocultarDropdown();
                        return;
                    }

                    requestController?.abort();
                    requestController = new AbortController();

                    try {
                        mostrarEstado('Buscando artículos…');

                        const response = await fetch(
                            `${urlBuscarItems}?filtro=${encodeURIComponent(filtro)}`,
                            {
                                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                                signal: requestController.signal
                            });

                        if (!response.ok) {
                            throw new Error(`HTTP ${response.status}`);
                        }

                        const data = await response.json();
                        renderizar(data);
                    } catch (error) {
                        if (error.name === 'AbortError') return;

                        console.error(error);
                        mostrarEstado('Ocurrió un error al buscar artículos.');
                    }
                }

                input.addEventListener('input', () => {
                    clearTimeout(timer);
                    timer = setTimeout(buscar, 300);
                });

                input.addEventListener('focus', () => {
                    if (dropdown.children.length > 0 && input.value.trim().length >= 2) {
                        dropdown.classList.add('show');
                    }
                });

                input.addEventListener('keydown', event => {
                    if (event.key === 'Enter') {
                        event.preventDefault();
                        clearTimeout(timer);
                        buscar();
                    }

                    if (event.key === 'Escape') {
                        ocultarDropdown();
                    }
                });

                return {
                    reset() {
                        clearTimeout(timer);
                        requestController?.abort();
                        input.value = '';
                        hidden.value = '';
                        selected.textContent = 'Ningún artículo seleccionado.';
                        dropdown.replaceChildren();
                        ocultarDropdown();
                    },
                    hide: ocultarDropdown
                };
            }

            const buscadorNuevo = crearBuscador({
                inputId: '#txtArticuloNuevoBuscar',
                dropdownId: '#ddlArticuloNuevo',
                hiddenId: '#hidArticuloNuevo',
                selectedId: '#lblArticuloNuevoSeleccionado'
            });

            const buscadorOrigen = crearBuscador({
                inputId: '#txtArticuloOrigenBuscar',
                dropdownId: '#ddlArticuloOrigen',
                hiddenId: '#hidArticuloOrigen',
                selectedId: '#lblArticuloOrigenSeleccionado'
            });

            document.addEventListener('click', event => {
                if (!modal.contains(event.target)) return;

                if (!event.target.closest('#txtArticuloNuevoBuscar') &&
                    !event.target.closest('#ddlArticuloNuevo')) {
                    buscadorNuevo?.hide();
                }
                if (!event.target.closest('#txtArticuloOrigenBuscar') &&
                    !event.target.closest('#ddlArticuloOrigen')) {
                    buscadorOrigen?.hide();
                }
            });

            form?.addEventListener('submit', event => {
                validarSeleccion();

                if (btnGuardar?.disabled) {
                    event.preventDefault();
                    return;
                }

                const nuevo = modal.querySelector('#hidArticuloNuevo')?.value || '';
                const origen = modal.querySelector('#hidArticuloOrigen')?.value || '';

                const confirmado = window.confirm(
                    `Se copiarán todos los descuentos de ${origen} al artículo nuevo ${nuevo}. ¿Desea continuar?`);

                if (!confirmado) {
                    event.preventDefault();
                    return;
                }

                btnGuardar.disabled = true;
                btnGuardar.textContent = 'Procesando…';
            });

            modal.addEventListener('show.bs.modal', () => {
                buscadorNuevo?.reset();
                buscadorOrigen?.reset();
                mostrarMensaje('');

                if (btnGuardar) {
                    btnGuardar.disabled = true;
                    btnGuardar.textContent = 'Crear copia de descuentos';
                }
            });
        })();
    </script>
    <script>
        (() => {
            const modal = document.getElementById('gestionNoPromoModal');
            if (!modal) return;

            const urlBuscarItems = '@Url.Action("BuscarItems", "Predescuentos")';
            const urlBuscarNoPromo = '@Url.Action("BuscarItemsNoPromo", "Predescuentos")';

            function escapeHtml(value) {
                return String(value ?? '')
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#039;');
            }

            function crearSelectorMultiple({
                formId,
                txtId,
                listId,
                selectedInputId,
                selectedContainerId,
                hiddenContainerId,
                buttonId,
                url,
                emptyMsg,
                listarSinFiltro = false
            }) {
                const form = modal.querySelector(formId);
                const txt = modal.querySelector(txtId);
                const list = modal.querySelector(listId);
                const selectedInput = modal.querySelector(selectedInputId);
                const selectedContainer = modal.querySelector(selectedContainerId);
                const hiddenContainer = modal.querySelector(hiddenContainerId);
                const button = modal.querySelector(buttonId);

                if (!form || !txt || !list || !selectedInput ||
                    !selectedContainer || !hiddenContainer || !button) {
                    return null;
                }

                const seleccionados = new Map();
                let timer = null;
                let requestController = null;
                let ultimosResultados = [];

                function normalizar(value) {
                    return String(value ?? '').trim().toUpperCase();
                }

                function clearResults(msg) {
                    list.innerHTML = `<div class="list-group-item text-muted">${escapeHtml(msg)}</div>`;
                }

                function renderSeleccionados() {
                    hiddenContainer.replaceChildren();
                    selectedContainer.replaceChildren();

                    const valores = Array.from(seleccionados.values())
                        .sort((a, b) => a.item.localeCompare(b.item, undefined, { numeric: true, sensitivity: 'base' }));

                    selectedInput.value = `${valores.length} artículo${valores.length === 1 ? '' : 's'} seleccionado${valores.length === 1 ? '' : 's'}`;
                    button.disabled = valores.length === 0;

                    if (valores.length === 0) {
                        const empty = document.createElement('span');
                        empty.className = 'text-muted';
                        empty.textContent = 'Ningún artículo seleccionado.';
                        selectedContainer.appendChild(empty);
                    }

                    valores.forEach(x => {
                        const hidden = document.createElement('input');
                        hidden.type = 'hidden';
                        hidden.name = 'itemNumbers';
                        hidden.value = x.item;
                        hiddenContainer.appendChild(hidden);

                        const badge = document.createElement('span');
                        badge.className = 'badge text-bg-secondary d-inline-flex align-items-center gap-2 p-2';

                        const text = document.createElement('span');
                        text.textContent = x.desc ? `${x.item} — ${x.desc}` : x.item;

                        const quitar = document.createElement('button');
                        quitar.type = 'button';
                        quitar.className = 'btn-close btn-close-white';
                        quitar.setAttribute('aria-label', `Quitar ${x.item}`);
                        quitar.addEventListener('click', () => {
                            seleccionados.delete(normalizar(x.item));
                            renderSeleccionados();
                            renderResultados(ultimosResultados);
                        });

                        badge.append(text, quitar);
                        selectedContainer.appendChild(badge);
                    });
                }

                function alternarSeleccion(item, desc) {
                    const key = normalizar(item);
                    if (!key) return;

                    if (seleccionados.has(key)) {
                        seleccionados.delete(key);
                    } else {
                        seleccionados.set(key, {
                            item: String(item).trim(),
                            desc: String(desc ?? '').trim()
                        });
                    }

                    renderSeleccionados();
                    renderResultados(ultimosResultados);
                }

                function renderResultados(data) {
                    ultimosResultados = Array.isArray(data) ? data : [];

                    if (ultimosResultados.length === 0) {
                        clearResults(emptyMsg);
                        return;
                    }

                    list.replaceChildren();

                    ultimosResultados.forEach(x => {
                        const item = x.itemNumber || x.ItemNumber || x.codArticulo || x.CodArticulo || '';
                        const desc = x.description || x.Description || x.desArticulo || x.DesArticulo || '';
                        const key = normalizar(item);

                        if (!key) return;

                        const seleccionado = seleccionados.has(key);
                        const row = document.createElement('button');
                        row.type = 'button';
                        row.className = 'list-group-item list-group-item-action d-flex align-items-center gap-3';
                        row.classList.toggle('active', seleccionado);
                        row.setAttribute('aria-pressed', seleccionado ? 'true' : 'false');

                        const check = document.createElement('input');
                        check.type = 'checkbox';
                        check.className = 'form-check-input flex-shrink-0';
                        check.checked = seleccionado;
                        check.tabIndex = -1;
                        check.style.pointerEvents = 'none';

                        const contenido = document.createElement('div');
                        contenido.className = 'text-start flex-grow-1';

                        const codigo = document.createElement('div');
                        codigo.className = 'fw-bold';
                        codigo.textContent = item;

                        const descripcion = document.createElement('div');
                        descripcion.className = seleccionado ? 'small text-white-50' : 'small text-muted';
                        descripcion.textContent = desc || 'Sin descripción';

                        contenido.append(codigo, descripcion);
                        row.append(check, contenido);
                        row.addEventListener('click', () => alternarSeleccion(item, desc));
                        list.appendChild(row);
                    });
                }

                async function buscar() {
                    const q = (txt.value || '').trim();

                    if (!listarSinFiltro && q.length < 2) {
                        ultimosResultados = [];
                        clearResults('Buscá un artículo para ver resultados…');
                        return;
                    }

                    requestController?.abort();
                    requestController = new AbortController();

                    try {
                        clearResults('Buscando…');

                        const res = await fetch(`${url}?filtro=${encodeURIComponent(q)}`, {
                            headers: { 'X-Requested-With': 'XMLHttpRequest' },
                            signal: requestController.signal
                        });

                        if (!res.ok) throw new Error('HTTP ' + res.status);

                        const data = await res.json();
                        renderResultados(data);
                    } catch (e) {
                        if (e.name === 'AbortError') return;

                        console.error(e);
                        ultimosResultados = [];
                        clearResults('Error al buscar artículos.');
                    }
                }

                txt.addEventListener('input', () => {
                    clearTimeout(timer);
                    timer = setTimeout(buscar, 300);
                });

                txt.addEventListener('keydown', ev => {
                    if (ev.key === 'Enter') {
                        ev.preventDefault();
                        clearTimeout(timer);
                        buscar();
                    }
                });

                form.addEventListener('submit', ev => {
                    if (seleccionados.size === 0) {
                        ev.preventDefault();
                        return;
                    }

                    const accion = formId === '#formDesactivarNoPromo'
                        ? 'desactivar los descuentos'
                        : 'reactivar los descuentos';

                    if (!window.confirm(`Se van a ${accion} de ${seleccionados.size} artículo(s). ¿Desea continuar?`)) {
                        ev.preventDefault();
                        return;
                    }

                    button.disabled = true;
                    button.textContent = 'Procesando…';
                });

                function reset() {
                    clearTimeout(timer);
                    requestController?.abort();
                    seleccionados.clear();
                    ultimosResultados = [];
                    txt.value = '';
                    button.textContent = formId === '#formDesactivarNoPromo'
                        ? 'Desactivar descuentos seleccionados'
                        : 'Reactivar descuentos seleccionados';
                    renderSeleccionados();

                    if (listarSinFiltro) {
                        buscar();
                    } else {
                        clearResults('Buscá un artículo para ver resultados…');
                    }
                }

                renderSeleccionados();

                return { reset };
            }

            const selectorDesactivar = crearSelectorMultiple({
                formId: '#formDesactivarNoPromo',
                txtId: '#txtItemFiltro',
                listId: '#lstItems',
                selectedInputId: '#txtItemSeleccionado',
                selectedContainerId: '#seleccionadosDesactivarNoPromo',
                hiddenContainerId: '#hiddenItemsDesactivarNoPromo',
                buttonId: '#btnDesactivarNoPromo',
                url: urlBuscarItems,
                emptyMsg: 'Sin resultados.'
            });

            const selectorReactivar = crearSelectorMultiple({
                formId: '#formReactivarNoPromo',
                txtId: '#txtNoPromoFiltro',
                listId: '#lstNoPromoItems',
                selectedInputId: '#txtNoPromoSeleccionado',
                selectedContainerId: '#seleccionadosReactivarNoPromo',
                hiddenContainerId: '#hiddenItemsReactivarNoPromo',
                buttonId: '#btnReactivarNoPromo',
                url: urlBuscarNoPromo,
                emptyMsg: 'Sin resultados en ART_NO_PROMO.',
                listarSinFiltro: true
            });

            modal.addEventListener('show.bs.modal', () => {
                selectorDesactivar?.reset();
                selectorReactivar?.reset();
            });
        })();
    </script>
    <script>
        (() => {
            const modal = document.getElementById('articulosExcluidosModal');
            if (!modal) return;

            const urlListar = '@Url.Action("ListarArticulosExcluidos", "Predescuentos")';
            const urlBuscar = '@Url.Action("BuscarArticulosParaExcluir", "Predescuentos")';
            const urlAgregar = '@Url.Action("AgregarArticuloExcluido", "Predescuentos")';
            const urlQuitar = '@Url.Action("QuitarArticuloExcluido", "Predescuentos")';

            const urlLineas = '@Url.Action("CatalogoLineasArticulos", "Predescuentos")';
            const urlClases = '@Url.Action("CatalogoClasesArticulos", "Predescuentos")';
            const urlMedidas = '@Url.Action("CatalogoMedidasArticulos", "Predescuentos")';

            const tokenInput = modal.querySelector('input[name="__RequestVerificationToken"]');
            const mensaje = document.getElementById('excluidosMensaje');
            const lstListado = document.getElementById('lstArticulosExcluidos');
            const lstGestion = document.getElementById('lstArticulosGestion');

            const btnBuscarListado = document.getElementById('btnBuscarExcluidosListado');
            const btnBuscarGestion = document.getElementById('btnBuscarExcluidosGestion');

            const txtListado = document.getElementById('exclFiltroTextoListado');

            const selLineaGestion = document.getElementById('exclFiltroLineaGestion');
            const selClaseGestion = document.getElementById('exclFiltroClaseGestion');
            const selMedidaGestion = document.getElementById('exclFiltroMedidaGestion');
            const txtGestion = document.getElementById('exclFiltroTextoGestion');

            let catalogosCargados = false;

            function getToken() {
                return tokenInput ? tokenInput.value : '';
            }

            function setMensaje(texto, error = false) {
                if (!mensaje) return;

                mensaje.textContent = texto || '';
                mensaje.classList.toggle('text-danger', error);
                mensaje.classList.toggle('text-success', !error && !!texto);
            }

            function escapeHtml(value) {
                return String(value ?? '')
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#039;');
            }

            function qs(params) {
                return new URLSearchParams(params).toString();
            }

            async function fetchJson(url) {
                const res = await fetch(url, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (!res.ok) throw new Error('HTTP ' + res.status);

                return await res.json();
            }

            function llenarSelect(select, data, textoDefault) {
                if (!select) return;

                select.innerHTML = '';

                const optDefault = document.createElement('option');
                optDefault.value = '';
                optDefault.textContent = textoDefault || '-- Todas --';
                select.appendChild(optDefault);

                if (!Array.isArray(data)) return;

                data.forEach(x => {
                    const codigo = x.codigo || x.Codigo || '';
                    const descripcion = x.descripcion || x.Descripcion || '';

                    if (!codigo) return;

                    const opt = document.createElement('option');
                    opt.value = codigo;
                    opt.textContent = descripcion && descripcion !== codigo
                        ? `${codigo} - ${descripcion}`
                        : codigo;

                    select.appendChild(opt);
                });
            }

            async function cargarClases(codLinea) {
                llenarSelect(selClaseGestion, [], 'Cargando...');

                const data = await fetchJson(`${urlClases}?codLinea=${encodeURIComponent(codLinea || '')}`);

                llenarSelect(selClaseGestion, data, '-- Todas --');
            }

            async function cargarCatalogos() {
                if (catalogosCargados) return;

                const [lineas, medidas] = await Promise.all([
                    fetchJson(urlLineas),
                    fetchJson(urlMedidas)
                ]);

                llenarSelect(selLineaGestion, lineas, '-- Todas --');
                llenarSelect(selMedidaGestion, medidas, '-- Todas --');

                await cargarClases('');

                catalogosCargados = true;
            }

            function filtrosListado() {
                return {
                    filtro: txtListado?.value || ''
                };
            }

            function filtrosGestion() {
                return {
                    codLinea: selLineaGestion?.value || '',
                    codClase: selClaseGestion?.value || '',
                    medida: selMedidaGestion?.value || '',
                    filtro: txtGestion?.value || ''
                };
            }

            function loadingListado() {
                lstListado.innerHTML = `
                    <div class="alert alert-info mb-0">
                        Cargando artículos excluidos.
                    </div>`;
            }

            function loadingGestion() {
                lstGestion.innerHTML = `
                    <div class="alert alert-info mb-0">
                        Buscando artículos disponibles.
                    </div>`;
            }

            function renderListado(data) {
                if (!Array.isArray(data) || data.length === 0) {
                    lstListado.innerHTML = `
                        <div class="alert alert-warning mb-0">
                            No hay artículos con ACEPTADESCUENTO = N.
                        </div>`;
                    return;
                }

                let html = `
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Artículo</th>
                                    <th>Descripción</th>
                                    <th>Línea</th>
                                    <th>Clase</th>
                                    <th>Medida</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>`;

                data.forEach(x => {
                    const item = x.itemNumber || '';

                    html += `
                        <tr>
                            <td><strong>${escapeHtml(item)}</strong></td>
                            <td>${escapeHtml(x.descripcion || '')}</td>
                            <td>${escapeHtml(x.codLinea || '')} ${x.desLinea ? ' - ' + escapeHtml(x.desLinea) : ''}</td>
                            <td>${escapeHtml(x.codClase || '')} ${x.desClase ? ' - ' + escapeHtml(x.desClase) : ''}</td>
                            <td>${escapeHtml(x.medida || '')}</td>
                            <td><span class="badge bg-danger">N</span></td>
                            <td class="text-end">
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger btn-quitar-excluido"
                                        data-item="${escapeHtml(item)}">
                                    Quitar
                                </button>
                            </td>
                        </tr>`;
                });

                html += `
                            </tbody>
                        </table>
                    </div>`;

                lstListado.innerHTML = html;
            }

            function renderGestion(data) {
                if (!Array.isArray(data) || data.length === 0) {
                    lstGestion.innerHTML = `
                        <div class="alert alert-warning mb-0">
                            No se encontraron artículos con ACEPTADESCUENTO = S.
                        </div>`;
                    return;
                }

                let html = `
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Artículo</th>
                                    <th>Descripción</th>
                                    <th>Línea</th>
                                    <th>Clase</th>
                                    <th>Medida</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>`;

                data.forEach(x => {
                    const item = x.itemNumber || '';

                    html += `
                        <tr>
                            <td><strong>${escapeHtml(item)}</strong></td>
                            <td>${escapeHtml(x.descripcion || '')}</td>
                            <td>${escapeHtml(x.codLinea || '')} ${x.desLinea ? ' - ' + escapeHtml(x.desLinea) : ''}</td>
                            <td>${escapeHtml(x.codClase || '')} ${x.desClase ? ' - ' + escapeHtml(x.desClase) : ''}</td>
                            <td>${escapeHtml(x.medida || '')}</td>
                            <td><span class="badge bg-success">S</span></td>
                            <td class="text-end">
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary btn-agregar-excluido"
                                        data-item="${escapeHtml(item)}">
                                    Agregar
                                </button>
                            </td>
                        </tr>`;
                });

                html += `
                            </tbody>
                        </table>
                    </div>`;

                lstGestion.innerHTML = html;
            }

            async function cargarListado() {
                try {
                    loadingListado();
                    setMensaje('');

                    const res = await fetch(`${urlListar}?${qs(filtrosListado())}`, {
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (!res.ok) throw new Error('HTTP ' + res.status);

                    const data = await res.json();
                    renderListado(data);
                } catch (e) {
                    console.error(e);
                    lstListado.innerHTML = `
                        <div class="alert alert-danger mb-0">
                            Error al cargar artículos excluidos.
                        </div>`;
                }
            }

            async function buscarGestion() {
                try {
                    loadingGestion();
                    setMensaje('');

                    const f = filtrosGestion();

                    if (!f.codLinea.trim() && !f.codClase.trim() && !f.medida.trim() && f.filtro.trim().length < 2) {
                        lstGestion.innerHTML = `
                            <div class="alert alert-secondary mb-0">
                                Seleccioná línea, clase, medida o escribí mínimo 2 caracteres en código/nombre.
                            </div>`;
                        return;
                    }

                    const res = await fetch(`${urlBuscar}?${qs(f)}`, {
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (!res.ok) throw new Error('HTTP ' + res.status);

                    const data = await res.json();
                    renderGestion(data);
                } catch (e) {
                    console.error(e);
                    lstGestion.innerHTML = `
                        <div class="alert alert-danger mb-0">
                            Error al buscar artículos disponibles.
                        </div>`;
                }
            }

            async function postArticulo(url, itemNumber) {
                const body = new URLSearchParams();
                body.append('itemNumber', itemNumber);

                const res = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'RequestVerificationToken': getToken(),
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: body.toString()
                });

                const data = await res.json().catch(() => null);

                if (!res.ok || !data || data.ok === false) {
                    throw new Error(data?.mensaje || 'No se pudo procesar la acción.');
                }

                return data;
            }

            modal.addEventListener('click', async (ev) => {
                const btnAgregar = ev.target.closest('.btn-agregar-excluido');
                const btnQuitar = ev.target.closest('.btn-quitar-excluido');

                if (!btnAgregar && !btnQuitar) return;

                const btn = btnAgregar || btnQuitar;
                const item = btn.dataset.item || '';

                if (!item) return;

                btn.disabled = true;

                try {
                    if (btnAgregar) {
                        const r = await postArticulo(urlAgregar, item);
                        setMensaje(r.mensaje || 'Artículo agregado.');
                    } else {
                        const r = await postArticulo(urlQuitar, item);
                        setMensaje(r.mensaje || 'Artículo quitado.');
                    }

                    await cargarListado();

                    const gestionActivo = document
                        .getElementById('panel-gestionar-excluidos')
                        ?.classList
                        .contains('active');

                    if (gestionActivo) {
                        await buscarGestion();
                    }
                } catch (e) {
                    console.error(e);
                    setMensaje(e.message || 'Error al procesar.', true);
                } finally {
                    btn.disabled = false;
                }
            });

                    function debounce(fn, delay = 350) {
            let timer = null;

            return (...args) => {
                clearTimeout(timer);
                timer = setTimeout(() => fn(...args), delay);
            };
        }

        const buscarListadoAuto = debounce(() => {
            cargarListado();
        }, 350);

        const buscarGestionAuto = debounce(() => {
            buscarGestion();
        }, 350);

        // Botones siguen funcionando manualmente
        btnBuscarListado?.addEventListener('click', cargarListado);
        btnBuscarGestion?.addEventListener('click', buscarGestion);

        // TAB LISTADO: buscar automáticamente por código o nombre
        txtListado?.addEventListener('input', () => {
            buscarListadoAuto();
        });

        txtListado?.addEventListener('keydown', ev => {
            if (ev.key === 'Enter') {
                ev.preventDefault();
                cargarListado();
            }
        });

        // TAB AGREGAR: línea cambia, recarga clases y busca automáticamente
        selLineaGestion?.addEventListener('change', async () => {
            await cargarClases(selLineaGestion.value);
            await buscarGestion();
        });

        // TAB AGREGAR: clase cambia y busca automáticamente
        selClaseGestion?.addEventListener('change', () => {
            buscarGestionAuto();
        });

        // TAB AGREGAR: medida cambia y busca automáticamente
        selMedidaGestion?.addEventListener('change', () => {
            buscarGestionAuto();
        });

        // TAB AGREGAR: texto busca automáticamente mientras escribe
        txtGestion?.addEventListener('input', () => {
            buscarGestionAuto();
        });

        txtGestion?.addEventListener('keydown', ev => {
            if (ev.key === 'Enter') {
                ev.preventDefault();
                buscarGestion();
            }
        });

            modal.addEventListener('show.bs.modal', async () => {
                try {
                    setMensaje('');
                    await cargarCatalogos();
                    await cargarListado();
                } catch (e) {
                    console.error(e);
                    setMensaje('Error cargando catálogos.', true);
                }
            });
        })();
    </script>
}