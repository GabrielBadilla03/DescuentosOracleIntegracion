@model IEnumerable<SolicitudesDescuentos.ModelsOracle.PREDESCUENTO>

@{
    ViewData["Title"] = "Index";
    var nombresClientes = ViewBag.NombresClientes as IDictionary<string, string>;

    var pendientesExcel = (Model ?? Enumerable.Empty<SolicitudesDescuentos.ModelsOracle.PREDESCUENTO>())
        .Where(p => string.Equals(p.GENERADO, "N", StringComparison.OrdinalIgnoreCase)
                && string.Equals((p.ESTADO ?? "").Trim(), "Aprobado", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(p => int.TryParse(p.CONSECUTIVO, out var c) ? c : 0)
        .ToList();

    var esPriceEditor = ViewBag.EsPriceEditor as bool? ?? false;

}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<h2 class="text-center">Solicitudes de Descuento</h2>
@{
    var filtroCodCliente = (ViewBag.FiltroCodCliente as string) ?? "";
    var filtroFechaInicio = (ViewBag.FiltroFechaInicio as string) ?? "";
    var filtroFechaFin = (ViewBag.FiltroFechaFin as string) ?? "";
    var nombreFiltro = "";

    if (!string.IsNullOrWhiteSpace(filtroCodCliente) && nombresClientes != null
        && nombresClientes.TryGetValue(filtroCodCliente, out var nom))
    {
        nombreFiltro = nom ?? "";
    }
}

@* Botones en la misma fila *@
<div class="row gx-2 gy-2 mb-3 justify-content-center justify-content-md-evenly align-items-center">

    @if (User.IsInRole("PRICE_EDITOR"))
    {
        <div class="col-auto">
            <button type="button" class="btn btn-danger"
                    data-bs-toggle="modal" data-bs-target="#gestionNoPromoModal">
                Desactivar / Reactivar descuentos
            </button>
        </div>


        <div class="col-auto">
            <button type="button" class="btn btn-danger"
                    data-bs-toggle="modal" data-bs-target="#copiarDescuentosArticuloModal">
                Agregar descuentos a artículo
            </button>
        </div>

        <div class="col-auto">
            <button type="button" class="btn btn-danger"
                    data-bs-toggle="modal" data-bs-target="#articulosExcluidosModal">
                Artículos Excluidos
            </button>
        </div>

    
        <div class="col-auto">
            <button type="button" class="btn btn-dark"
                    data-bs-toggle="modal" data-bs-target="#reportesModal">
                Reportes
            </button>
        </div>
    }
    <div class="col-auto">
        <button type="button" class="btn btn-danger"
                data-bs-toggle="modal" data-bs-target="#crearModal">
            Crear Nueva Solicitud
        </button>
    </div>
</div>


@* (Opcional) feedback rápido del flujo *@
@if (TempData["InfoFlujo"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["InfoFlujo"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<form asp-action="Index" asp-controller="Predescuentos" method="get" class="mb-4">
    <div class="card shadow-sm mx-auto" style="max-width: 1250px;">
        <div class="card-body">
            <div class="row g-3 align-items-end">

                <!-- Buscar cliente -->
                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label">Buscar cliente (código o nombre)</label>
                    <input type="text"
                           class="form-control"
                           id="txtClienteFiltro"
                           placeholder="Ej: 1000123 o 'Ferretería'"
                           autocomplete="off" />
                </div>

                <!-- Resultados cliente -->
                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label">Resultados</label>
                    <select class="form-select" id="selClientes" name="codCliente">
                        <option value="">-- Seleccione un cliente --</option>

                        @if (!string.IsNullOrWhiteSpace(filtroCodCliente))
                        {
                            <option value="@filtroCodCliente" selected>
                                @(string.IsNullOrWhiteSpace(nombreFiltro)
                                                            ? filtroCodCliente
                                                            : $"{nombreFiltro} ({filtroCodCliente})")
                            </option>
                        }
                    </select>
                </div>

                <!-- Fecha inicio -->
                <div class="col-12 col-md-6 col-lg-2">
                    <label class="form-label">Fecha inicio</label>
                    <input type="date"
                           class="form-control"
                           name="fechaInicio"
                           value="@filtroFechaInicio" />
                </div>

                <!-- Fecha fin -->
                <div class="col-12 col-md-6 col-lg-2">
                    <label class="form-label">Fecha fin</label>
                    <input type="date"
                           class="form-control"
                           name="fechaFin"
                           value="@filtroFechaFin" />
                </div>

                <!-- Botones -->
                <div class="col-12 col-lg-1">
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger" id="btnFiltrarCliente">
                            Filtrar
                        </button>
                    </div>
                </div>

                <div class="col-12 col-lg-auto">
                    <a asp-action="Index"
                       asp-controller="Predescuentos"
                       class="btn btn-outline-secondary w-100">
                        Limpiar
                    </a>
                </div>

            </div>
        </div>
    </div>
</form>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card shadow h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        Cliente:
                        @(
                                            nombresClientes != null
                                            && !string.IsNullOrWhiteSpace(item.COD_CLIENTE)
                                            && nombresClientes.ContainsKey(item.COD_CLIENTE)
                                            ? nombresClientes[item.COD_CLIENTE]
                                            : item.COD_CLIENTE
                                            )
                    </h5>
                    <p class="card-text">
                        <strong>Solicitud:</strong> @item.FECHASOLICITUD.ToShortDateString()<br />

                        <strong>Tipo Descuento:</strong> @item.TIPODESCUENTO<br />

                        <strong>Inicio:</strong>
                        @(
                                            item.FECHAINICIO == null || item.FECHAINICIO == DateTime.MinValue
                                            ? "N/A"
                                            : item.FECHAINICIO.Value.ToShortDateString()
                                            )<br />

                        <strong>Fin:</strong>
                        @(
                                            item.FECHAFIN == null || item.FECHAFIN == DateTime.MinValue
                                            ? "N/A"
                                            : item.FECHAFIN.Value.ToShortDateString()
                                            )<br />

                        <strong>Estado:</strong>
                        @(
                                            string.Equals((item.ESTADO ?? "").Trim(), "R", StringComparison.OrdinalIgnoreCase)
                                            ? "Reversado"
                                            : item.ESTADO
                         )<br />

                        <strong>Autorizado por:</strong> @item.AUTORIZADO_POR<br />

                        <strong>Aplicación:</strong>
                        @(item.FECHA_APLICACION.HasValue
                                            ? item.FECHA_APLICACION.Value.ToShortDateString()
                                            : "No aplicada")
                    </p>
                </div>

                <div class="card-footer text-center">
                    @* Solo se permite editar / eliminar en ciertos estados *@
                    @{
                        var estadoItem = (item.ESTADO ?? "").Trim();
                        var puedeEditarEliminar =
                        !estadoItem.Equals("Pendiente Aprobacion", StringComparison.OrdinalIgnoreCase) &&
                        !estadoItem.Equals("Aprobado", StringComparison.OrdinalIgnoreCase) &&
                        !estadoItem.Equals("Reversado", StringComparison.OrdinalIgnoreCase);
                    }

                    @if (puedeEditarEliminar)
                    {
                        <a asp-action="Edit"
                           asp-route-consecutivo="@item.CONSECUTIVO"
                           asp-route-codcliente="@item.COD_CLIENTE"
                           class="btn btn-sm btn-danger mx-1">
                            Editar
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.CONSECUTIVO"
                           class="btn btn-sm btn-danger mx-1">
                            Eliminar
                        </a>
                    }

                    <a asp-action="Details"
                       asp-route-buNombre="@item.BU_NOMBRE"
                       asp-route-codCliente="@item.COD_CLIENTE"
                       asp-route-id="@item.CONSECUTIVO"
                       class="btn btn-sm btn-danger">
                        Detalles
                    </a>
                </div>
            </div>
        </div>
    }
</div>

@* Modal: Reportes *@
<div class="modal fade" id="reportesModal" tabindex="-1" aria-labelledby="reportesModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="reportesModalLabel">Reportes</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <div class="d-grid gap-2">
                    <a asp-controller="ReportesCobros"
                       asp-action="ResumenCobrosAgente"
                       class="btn btn-danger">
                        Cobros por Agente
                    </a>
                    <a asp-controller="SeguimientoFacturas"
                       asp-action="Index"
                       class="btn btn-danger">
                        InfoRouter
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@* Modal: Crear *@
<div class="modal fade" id="crearModal" tabindex="-1" aria-labelledby="crearModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="crearModalLabel">Nueva Solicitud</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body text-center">
                <p>¿Qué desea hacer?</p>
                <a asp-action="Create" class="btn btn-danger mb-2 w-100">Crear solo Solicitud</a>

                <button class="btn btn-secondary w-100" disabled>
                    Crear Cliente y Solicitud (Próximamente)
                </button>
            </div>
        </div>
    </div>
</div>

@* Modal: Generar Excel (checklist GENERADO = N) *@
<div class="modal fade" id="generarExcelModal" tabindex="-1" aria-labelledby="generarExcelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="generarExcelModalLabel">Generar Excel (Solicitudes no generadas)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <form asp-action="DescargarExcel"
                  asp-controller="Predescuentos"
                  method="post"
                  id="formGenerarExcel"
                  target="_blank">
                @Html.AntiForgeryToken()

                <input type="hidden" name="tipoFiltro" id="tipoFiltroExcel" value="promocional" />

                <div class="modal-body">

                    @if (pendientesExcel.Any())
                    {
                        <div class="alert alert-info mb-3">
                            Seleccioná las solicitudes para incluirlas en el Excel.
                        </div>

                        <!-- Filtros -->
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="text-muted small">Filtrar:</span>
                            <div class="btn-group btn-group-sm" role="group" aria-label="Filtro tipo descuento">
                                <button type="button" class="btn btn-outline-success active" id="btnFiltroPromo">
                                    Promocionales
                                </button>
                                <button type="button" class="btn btn-outline-success" id="btnFiltroFijo">
                                    Fijos
                                </button>
                            </div>
                        </div>

                        <div class="list-group">
                            @foreach (var p in pendientesExcel)
                            {
                                var nombreCliente =
                                (nombresClientes != null
                                && !string.IsNullOrWhiteSpace(p.COD_CLIENTE)
                                && nombresClientes.ContainsKey(p.COD_CLIENTE))
                                ? nombresClientes[p.COD_CLIENTE]
                                : p.COD_CLIENTE;

                                var tipoNorm =
                                string.Equals(p.TIPODESCUENTO, "Descuento Promocional", StringComparison.OrdinalIgnoreCase)
                                ? "promocional"
                                : string.Equals(p.TIPODESCUENTO, "Descuento Fijo", StringComparison.OrdinalIgnoreCase)
                                ? "fijo"
                                : "otro";

                                <label class="list-group-item d-flex gap-2 align-items-start item-solicitud"
                                       data-tipo="@tipoNorm">
                                    <input class="form-check-input mt-1"
                                           type="checkbox"
                                           name="seleccionados"
                                           value="@($"{p.BU_NOMBRE}|{p.CONSECUTIVO}")" />

                                    <div class="w-100">
                                        <div class="d-flex justify-content-between">
                                            <div>
                                                <strong>@nombreCliente</strong>
                                                <span class="text-muted">(@p.COD_CLIENTE)</span>
                                            </div>
                                            <span class="badge bg-secondary">Consecutivo: @p.CONSECUTIVO</span>
                                        </div>

                                        <div class="small text-muted">
                                            Solicitud: @p.FECHASOLICITUD.ToShortDateString()
                                            &nbsp;|&nbsp; Tipo: @p.TIPODESCUENTO
                                            &nbsp;|&nbsp; Estado: @p.ESTADO
                                        </div>
                                    </div>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            No hay solicitudes que no se hayan <strong>GENERADO</strong> en Excel.
                        </div>
                    }


                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>

                    @* Aún sin controller: por ahora no hace nada *@
                    <button type="submit" class="btn btn-success" @(pendientesExcel.Any() ? "" : "disabled")>
                        Generar Excel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


@* Modal: Copiar descuentos de un artículo existente a un artículo nuevo *@
<div class="modal fade" id="copiarDescuentosArticuloModal" tabindex="-1"
     aria-labelledby="copiarDescuentosArticuloModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content shadow">
            <form asp-action="CopiarDescuentosAArticuloNuevo"
                  asp-controller="Predescuentos"
                  method="post"
                  id="formCopiarDescuentosArticulo">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title" id="copiarDescuentosArticuloModalLabel">
                        Agregar descuentos a un artículo nuevo
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <div class="alert alert-info">
                        Seleccione el artículo nuevo y luego un artículo existente que ya tenga descuentos.
                        Se copiarán todos sus descuentos de cliente y promoción; únicamente cambiará el código del artículo.
                    </div>

                    <div class="row g-4">
                        <div class="col-12 col-lg-6">
                            <div class="card h-100 border-primary">
                                <div class="card-header fw-bold">1. Artículo nuevo</div>
                                <div class="card-body">
                                    <label class="form-label" for="txtArticuloNuevoBuscar">
                                        Buscar por código o nombre
                                    </label>

                                    <div class="position-relative">
                                        <input type="text"
                                               class="form-control"
                                               id="txtArticuloNuevoBuscar"
                                               placeholder="Escriba mínimo 2 caracteres"
                                               autocomplete="off" />

                                        <div class="dropdown-menu w-100 shadow"
                                             id="ddlArticuloNuevo"
                                             style="max-height: 320px; overflow-y: auto;"></div>
                                    </div>

                                    <input type="hidden" name="itemNuevo" id="hidArticuloNuevo" />

                                    <div class="mt-3">
                                        <div class="small text-muted">Seleccionado:</div>
                                        <div class="border rounded p-2 bg-light" id="lblArticuloNuevoSeleccionado">
                                            Ningún artículo seleccionado.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <div class="card h-100 border-secondary">
                                <div class="card-header fw-bold">2. Artículo origen de los descuentos</div>
                                <div class="card-body">
                                    <label class="form-label" for="txtArticuloOrigenBuscar">
                                        Buscar por código o nombre
                                    </label>

                                    <div class="position-relative">
                                        <input type="text"
                                               class="form-control"
                                               id="txtArticuloOrigenBuscar"
                                               placeholder="Escriba mínimo 2 caracteres"
                                               autocomplete="off" />

                                        <div class="dropdown-menu w-100 shadow"
                                             id="ddlArticuloOrigen"
                                             style="max-height: 320px; overflow-y: auto;"></div>
                                    </div>

                                    <input type="hidden" name="itemOrigen" id="hidArticuloOrigen" />

                                    <div class="mt-3">
                                        <div class="small text-muted">Seleccionado:</div>
                                        <div class="border rounded p-2 bg-light" id="lblArticuloOrigenSeleccionado">
                                            Ningún artículo seleccionado.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning mt-4 mb-0 d-none" id="mensajeCopiarDescuentos"></div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="submit" class="btn btn-danger" id="btnCopiarDescuentos" disabled>
                        Crear copia de descuentos
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="gestionNoPromoModal" tabindex="-1" aria-labelledby="gestionNoPromoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="gestionNoPromoModalLabel">Desactivar / Reactivar descuentos por artículo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <ul class="nav nav-tabs mb-3" id="noPromoTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active"
                                id="tab-desactivar-descuentos"
                                data-bs-toggle="tab"
                                data-bs-target="#panel-desactivar-descuentos"
                                type="button"
                                role="tab">
                            Desactivar descuentos
                        </button>
                    </li>

                    <li class="nav-item" role="presentation">
                        <button class="nav-link"
                                id="tab-reactivar-descuentos"
                                data-bs-toggle="tab"
                                data-bs-target="#panel-reactivar-descuentos"
                                type="button"
                                role="tab">
                            Reactivar descuentos
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="panel-desactivar-descuentos" role="tabpanel">
                        <form asp-action="DesactivarArticuloNoPromo"
                              asp-controller="Predescuentos"
                              method="post"
                              id="formDesactivarNoPromo">
                            @Html.AntiForgeryToken()

                            <div class="alert alert-info py-2">
                                Seleccione uno o varios artículos. Al confirmar solamente se dejarán en
                                <strong>ART_NO_PROMO como Activo / N</strong>. El job hará el respaldo de los
                                descuentos actuales en ART_DET_NO_PROMO antes de generar el archivo.
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-lg-6">
                                    <label class="form-label">Buscar artículo</label>
                                    <input type="text"
                                           class="form-control"
                                           id="txtItemFiltro"
                                           placeholder="Ej: 100-ABC o parte del código"
                                           autocomplete="off" />
                                    <div class="form-text">Escribí mínimo 2 caracteres. Podés hacer varias búsquedas sin perder la selección.</div>
                                </div>

                                <div class="col-12 col-lg-6">
                                    <label class="form-label">Artículos seleccionados</label>
                                    <input type="text"
                                           class="form-control"
                                           id="txtItemSeleccionado"
                                           value="0 artículos seleccionados"
                                           readonly />
                                    <div id="hiddenItemsDesactivarNoPromo"></div>
                                </div>

                                <div class="col-12">
                                    <label class="form-label">Selección actual</label>
                                    <div id="seleccionadosDesactivarNoPromo"
                                         class="border rounded p-2 bg-light d-flex flex-wrap gap-2"
                                         style="min-height: 44px;">
                                        <span class="text-muted">Ningún artículo seleccionado.</span>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <label class="form-label">Resultados</label>
                                    <div class="list-group" id="lstItems">
                                        <div class="list-group-item text-muted">Buscá un artículo para ver resultados…</div>
                                    </div>
                                </div>
                            </div>

                            <div class="text-end mt-3">
                                <button type="submit" class="btn btn-danger" id="btnDesactivarNoPromo" disabled>
                                    Desactivar descuentos seleccionados
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="tab-pane fade" id="panel-reactivar-descuentos" role="tabpanel">
                        <form asp-action="ReactivarArticuloNoPromo"
                              asp-controller="Predescuentos"
                              method="post"
                              id="formReactivarNoPromo">
                            @Html.AntiForgeryToken()

                            <div class="alert alert-info py-2">
                                Seleccione uno o varios artículos activos en ART_NO_PROMO. Al confirmar se pasarán a
                                <strong>Inactivo / N</strong> y se conservará ART_DET_NO_PROMO para que el job restaure
                                ese respaldo.
                            </div>

                            <div class="row g-3">
                                <div class="col-12 col-lg-6">
                                    <label class="form-label">Buscar artículo en ART_NO_PROMO</label>
                                    <input type="text"
                                           class="form-control"
                                           id="txtNoPromoFiltro"
                                           placeholder="Ej: 100-ABC o parte del código"
                                           autocomplete="off" />
                                    <div class="form-text">Solo muestra artículos con desactivación activa. Sin filtro muestra todos.</div>
                                </div>

                                <div class="col-12 col-lg-6">
                                    <label class="form-label">Artículos seleccionados</label>
                                    <input type="text"
                                           class="form-control"
                                           id="txtNoPromoSeleccionado"
                                           value="0 artículos seleccionados"
                                           readonly />
                                    <div id="hiddenItemsReactivarNoPromo"></div>
                                </div>

                                <div class="col-12">
                                    <label class="form-label">Selección actual</label>
                                    <div id="seleccionadosReactivarNoPromo"
                                         class="border rounded p-2 bg-light d-flex flex-wrap gap-2"
                                         style="min-height: 44px;">
                                        <span class="text-muted">Ningún artículo seleccionado.</span>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <label class="form-label">Resultados</label>
                                    <div class="list-group" id="lstNoPromoItems">
                                        <div class="list-group-item text-muted">Cargando artículos activos…</div>
                                    </div>
                                </div>
                            </div>

                            <div class="text-end mt-3">
                                <button type="submit" class="btn btn-success" id="btnReactivarNoPromo" disabled>
                                    Reactivar descuentos seleccionados
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
