@model SolicitudesDescuentos.ModelsOracle.PREDESCUENTO

@{
    ViewData["Title"] = "Eliminar";
    // Diccionario que viene desde el controlador: ViewBag.DesLineas
    var desLineas = ViewBag.DesLineas as IDictionary<string, string>;
}

<h1 class="text-center">Eliminar Solicitud de Descuento</h1>

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-action="Index" class="btn btn-secondary btn-sm">
        Volver Atrás
    </a>

    <!-- OJO: aquí asumimos que tu POST Delete usa el mismo nombre de ruta (por ejemplo consecutivo o id) -->
    <form asp-action="Delete"
          method="post"
          onsubmit="return confirm('¿Estás seguro que deseas eliminar este registro? Esta acción no se puede deshacer.');"
          style="display:inline;">

        <!-- Campo oculto con el consecutivo del modelo Oracle -->
        <input type="hidden" asp-for="CONSECUTIVO" />

        <button type="submit" class="btn btn-danger btn-sm">
            Eliminar
        </button>
    </form>
</div>

<div>
    <hr />
    <div class="container">
        <div class="row">
            <!-- Columna Izquierda: datos no fechas -->
            <div class="col-md-6 col-12">
                <div class="mb-3">
                    <strong>Cliente:</strong><br />
                    @((string)ViewBag.NombreCliente ?? "Cliente no encontrado")
                </div>
                <div class="mb-3">
                    <strong>@Html.DisplayNameFor(m => m.TIPODESCUENTO):</strong><br />
                    @Html.DisplayFor(m => m.TIPODESCUENTO)
                </div>
                <div class="mb-3">
                    <strong>@Html.DisplayNameFor(m => m.OBSERVACIONES):</strong><br />
                    @Html.DisplayFor(m => m.OBSERVACIONES)
                </div>
                <div class="mb-3">
                    <strong>@Html.DisplayNameFor(m => m.ESTADO):</strong><br />
                    @Html.DisplayFor(m => m.ESTADO)
                </div>
                <div class="mb-3">
                    <strong>@Html.DisplayNameFor(m => m.AUTORIZADO_POR):</strong><br />
                    @(string.IsNullOrWhiteSpace(Model.AUTORIZADO_POR)
                                        ? "Sin autorizado"
                                        : Model.AUTORIZADO_POR)
                </div>
            </div>

            <!-- Columna Derecha: fechas -->
            <div class="col-md-6 col-12 text-md-start text-start">
                <div class="mb-3">
                    <strong>@Html.DisplayNameFor(m => m.FECHASOLICITUD):</strong><br />
                    @Html.DisplayFor(m => m.FECHASOLICITUD)
                </div>
                <div class="mb-3">
                    <strong>@Html.DisplayNameFor(m => m.FECHAINICIO):</strong><br />
                    @(Model.FECHAINICIO == null || Model.FECHAINICIO == DateTime.MinValue
                                        ? "N/A"
                                        : Model.FECHAINICIO?.ToString("dd/MM/yyyy"))
                </div>
                <div class="mb-3">
                    <strong>@Html.DisplayNameFor(m => m.FECHAFIN):</strong><br />
                    @(Model.FECHAFIN == null || Model.FECHAFIN == DateTime.MinValue
                                        ? "N/A"
                                        : Model.FECHAFIN?.ToString("dd/MM/yyyy"))
                </div>
                <div class="mb-3">
                    <strong>@Html.DisplayNameFor(m => m.FECHA_APLICACION):</strong><br />
                    @(Model.FECHA_APLICACION == null
                                        ? "Sin fecha aplicación"
                                        : Model.FECHA_APLICACION?.ToString("dd/MM/yyyy"))
                </div>
            </div>
        </div>
    </div>
</div>

<hr />

<h4>Detalles de Descuentos</h4>

@if (Model.PREDETDESCUENTOs != null && Model.PREDETDESCUENTOs.Any())
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>Línea</th>
                    <th>Artículo</th>
                    <th>Tipo</th>
                    <th>Valor</th>
                    <th>Clase</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detalle in Model.PREDETDESCUENTOs)
                {
                    var codLinea = detalle.COD_LINEA;
                    string nombreLinea = "";
                    if (desLineas != null
                    && !string.IsNullOrEmpty(codLinea)
                    && desLineas.ContainsKey(codLinea))
                    {
                        nombreLinea = desLineas[codLinea];
                    }

                <tr>
                    <td>@codLinea - @nombreLinea</td>
                    <td>@detalle.COD_ARTICULO</td>
                    <td>
                        @(detalle.TIPO == "P"
                                            ? "Porcentaje"
                                            : detalle.TIPO == "M"
                                            ? "Monto"
                                            : detalle.TIPO)
                        </td>
                        <td>@detalle.VALOR</td>
                        <td>@detalle.COD_CLASE</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <p>No hay detalles de descuento asociados.</p>
}
