@{
    ViewData["Title"] = "Seleccionar aplicación";

    var descuentosHabilitado =
        ViewBag.DescuentosHabilitado is bool descuentos &&
        descuentos;

    var tomaFisicaHabilitada =
        ViewBag.TomaFisicaHabilitada is bool tomaFisica &&
        tomaFisica;
}

<div class="container d-flex justify-content-center"
     style="margin-top: 90px;">

    <div class="card shadow-sm p-4"
         style="max-width: 430px; width: 100%;">

        <h3 class="text-center mb-2">
            Iniciar Sesión
        </h3>

        <p class="text-muted text-center mb-4">
            Seleccione la aplicación a la que desea ingresar.
        </p>

        @if (TempData["LoginError"] != null)
        {
            <div class="alert alert-danger">
                @TempData["LoginError"]
            </div>
        }

        @if (descuentosHabilitado ||
             tomaFisicaHabilitada)
        {
            <div class="d-grid gap-3">

                @if (descuentosHabilitado)
                {
                    <a asp-controller="Account"
                       asp-action="DescuentosLogin"
                       class="btn btn-danger btn-lg">
                        Descuentos
                    </a>
                }

                @if (tomaFisicaHabilitada)
                {
                    <a asp-controller="Account"
                       asp-action="TomaFisicaLogin"
                       class="btn btn-outline-danger btn-lg">
                        Toma Física
                    </a>
                }

            </div>
        }
        else
        {
            <div class="alert alert-warning mb-0">
                No hay aplicaciones habilitadas en esta instalación.
            </div>
        }

    </div>
</div>
