@{
    ViewData["Title"] = "Registro de códigos de barras";
}

<style>
    .toma-page {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto 24px auto;
        padding: 0 4px;
    }

    .toma-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, .06);
        overflow: hidden;
    }

        .toma-card .card-body {
            padding: 10px;
        }

    .toma-header {
        margin-bottom: 8px;
    }

        .toma-header h2 {
            margin: 0;
            font-size: 1.15rem;
        }

    .instruccion {
        font-size: .78rem;
        line-height: 1.25;
    }

    .contador {
        min-width: 95px;
        text-align: center;
        font-size: .75rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .toma-ventanas {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 3px;
        margin-bottom: 8px;
    }

    .toma-ventana-btn {
        width: 100%;
        min-width: 0;
        padding: 7px 4px;
        border: 1px solid #dc3545;
        border-radius: 4px;
        background: #fff;
        color: #dc3545;
        font-size: .82rem;
        font-weight: 700;
        text-align: center;
        text-decoration: none;
        white-space: nowrap;
    }

        .toma-ventana-btn:hover,
        .toma-ventana-btn:focus {
            color: #fff;
            background: #bb2d3b;
            border-color: #b02a37;
        }

        .toma-ventana-btn.activo {
            color: #fff;
            background: #dc3545;
            border-color: #dc3545;
        }

    /*
     * AGREGAR
     * Se conserva el diseño actual:
     * Artículo | Código barras
     * Descripción a todo el ancho.
     */
    .captura-encabezado,
    .captura-grid-principal {
        display: grid;
        grid-template-columns: minmax(105px, 1fr) minmax(145px, 1.35fr);
        gap: 2px;
        width: 100%;
        align-items: center;
    }

    .captura-encabezado {
        padding: 0 2px 4px 2px;
        color: #495057;
        font-size: .69rem;
        font-weight: 700;
    }

        .captura-encabezado > div {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    #contenedorFilas {
        width: 100%;
    }

    .captura-fila {
        padding: 4px 2px;
        margin: 0;
        border-top: 1px solid #e5e7eb;
        background: #fff;
        transition: background-color .12s ease-in-out;
    }

        .captura-fila:last-child {
            border-bottom: 1px solid #e5e7eb;
        }

        .captura-fila.guardada {
            background: #f0faf4;
        }

    .captura-grid-principal > div {
        min-width: 0;
    }

    .captura-descripcion {
        width: 100%;
        margin-top: 2px;
    }

    .captura-fila .form-control {
        width: 100%;
        min-width: 0;
        height: 38px;
        min-height: 38px;
        padding: 4px 5px;
        border-radius: 3px;
        font-size: 16px;
        line-height: 1.1;
    }

    .codigo-articulo {
        text-transform: uppercase;
    }

    .descripcion-articulo {
        width: 100% !important;
        background-color: #f8f9fa !important;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .codigo-barras {
        padding-left: 4px !important;
        padding-right: 4px !important;
    }

    .mensaje-fila {
        min-height: 0;
        margin-top: 2px;
        padding-left: 2px;
        font-size: .68rem;
        line-height: 1.15;
    }

        .mensaje-fila:empty {
            display: none;
        }

        .mensaje-fila.error {
            display: block;
            color: #dc3545;
            font-weight: 600;
        }

        .mensaje-fila.ok {
            display: block;
            color: #198754;
            font-weight: 600;
        }

    /*
     * CONSULTAR
     */
    .consulta-busqueda {
        display: grid;
        grid-template-columns: minmax(105px, 1fr) minmax(145px, 1.35fr);
        gap: 2px;
        width: 100%;
        align-items: end;
    }

    .consulta-campo {
        min-width: 0;
    }

        .consulta-campo label {
            display: block;
            margin: 0 0 3px 2px;
            color: #495057;
            font-size: .69rem;
            font-weight: 700;
        }

        .consulta-campo .form-control {
            width: 100%;
            min-width: 0;
            height: 38px;
            min-height: 38px;
            padding: 4px 5px;
            border-radius: 3px;
            font-size: 16px;
        }

    .consulta-ayuda {
        margin-top: 4px;
        color: #6c757d;
        font-size: .68rem;
        line-height: 1.2;
    }

    .consulta-resultado {
        margin-top: 10px;
        border-top: 1px solid #dee2e6;
        padding-top: 8px;
    }

    .consulta-articulo {
        margin-bottom: 7px;
    }

    .consulta-articulo-codigo {
        font-size: .8rem;
        font-weight: 700;
    }

    .consulta-articulo-descripcion {
        margin-top: 2px;
        padding: 5px 6px;
        border: 1px solid #dee2e6;
        border-radius: 3px;
        background: #f8f9fa;
        font-size: .78rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .consulta-titulo-lista {
        margin-bottom: 3px;
        color: #495057;
        font-size: .69rem;
        font-weight: 700;
    }

    .consulta-codigos {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .codigo-consulta-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 5px;
        width: 100%;
        padding: 7px 6px;
        border: 1px solid #ced4da;
        border-radius: 3px;
        background: #fff;
        color: #212529;
        font-size: .85rem;
        text-align: left;
    }

        .codigo-consulta-item:hover,
        .codigo-consulta-item:focus {
            border-color: #dc3545;
            background: #fff5f5;
        }

        .codigo-consulta-item .codigo-texto {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-weight: 700;
        }

        .codigo-consulta-item .codigo-eliminar {
            flex: 0 0 auto;
            color: #dc3545;
            font-size: .65rem;
            font-weight: 700;
        }

    .consulta-mensaje {
        margin-top: 7px;
        font-size: .72rem;
        font-weight: 600;
    }

        .consulta-mensaje.error {
            color: #dc3545;
        }

        .consulta-mensaje.ok {
            color: #198754;
        }

    .sin-codigos {
        padding: 8px;
        border: 1px dashed #ced4da;
        border-radius: 3px;
        color: #6c757d;
        font-size: .75rem;
        text-align: center;
    }

    @@media (max-width: 767.98px) {
        .toma-page {
            padding: 0 1px;
            margin-bottom: 12px;
        }

        .toma-card {
            border-radius: 4px;
        }

            .toma-card .card-body {
                padding: 5px 3px;
            }

        .toma-header {
            margin-bottom: 5px;
        }

            .toma-header h2 {
                font-size: .95rem;
            }

        .instruccion {
            font-size: .68rem;
        }

        .toma-ventanas {
            gap: 2px;
            margin-bottom: 5px;
        }

        .toma-ventana-btn {
            padding: 6px 2px;
            border-radius: 3px;
            font-size: .72rem;
        }

        .captura-encabezado,
        .captura-grid-principal,
        .consulta-busqueda {
            grid-template-columns: minmax(100px, .95fr) minmax(140px, 1.30fr);
            gap: 1px;
        }

        .captura-encabezado {
            padding-left: 1px;
            padding-right: 1px;
            font-size: .62rem;
        }

        .captura-fila {
            padding: 3px 1px;
        }

            .captura-fila .form-control {
                height: 37px;
                min-height: 37px;
                padding: 3px 4px;
                border-radius: 2px;
                font-size: 16px;
            }

        .captura-descripcion {
            margin-top: 1px;
        }

        .mensaje-fila {
            font-size: .62rem;
            margin-top: 1px;
        }

        .contador {
            min-width: 82px;
            font-size: .67rem;
        }

        .consulta-campo label {
            font-size: .62rem;
        }

        .consulta-campo .form-control {
            height: 37px;
            min-height: 37px;
            padding: 3px 4px;
            border-radius: 2px;
            font-size: 16px;
        }

        .consulta-articulo-descripcion {
            font-size: .72rem;
        }

        .codigo-consulta-item {
            padding: 6px 5px;
            font-size: .8rem;
        }
    }

    @@media (max-width: 390px) {
        .captura-encabezado,
        .captura-grid-principal,
        .consulta-busqueda {
            grid-template-columns: minmax(92px, .9fr) minmax(132px, 1.25fr);
        }

        .toma-card .card-body {
            padding-left: 2px;
            padding-right: 2px;
        }
    }
</style>

<div class="toma-page">

    <div class="toma-header">
        <h2>Registro de códigos de barras</h2>
    </div>

    <div class="toma-ventanas">
        <button type="button"
                id="btnVentanaAgregar"
                class="toma-ventana-btn activo">
            Agregar
        </button>

        <button type="button"
                id="btnVentanaConsultar"
                class="toma-ventana-btn">
            Consultar
        </button>

        <a asp-controller="Predescuentos"
           asp-action="Index"
           class="toma-ventana-btn">
            Volver
        </a>
    </div>

    <form id="formAntiforgery" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <div id="panelAgregar">
        <div class="card toma-card">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                    <div class="small text-muted instruccion">
                        Artículo → Enter → código de barras → Enter.
                    </div>

                    <div id="contadorGuardados"
                         class="badge bg-success contador">
                        Guardados: 0
                    </div>
                </div>

                <div class="captura-encabezado">
                    <div>Artículo</div>
                    <div>Código barras</div>
                </div>

                <div id="contenedorFilas"></div>

            </div>
        </div>
    </div>

    <div id="panelConsultar" class="d-none">
        <div class="card toma-card">
            <div class="card-body">

                <div class="consulta-busqueda">

                    <div class="consulta-campo">
                        <label for="consultaArticulo">
                            Artículo
                        </label>

                        <input type="text"
                               id="consultaArticulo"
                               class="form-control"
                               maxlength="20"
                               autocomplete="off"
                               autocapitalize="characters"
                               spellcheck="false"
                               placeholder="Código artículo" />
                    </div>

                    <div class="consulta-campo">
                        <label for="consultaCodigoBarras">
                            Código barras
                        </label>

                        <input type="text"
                               id="consultaCodigoBarras"
                               class="form-control"
                               maxlength="25"
                               autocomplete="off"
                               spellcheck="false"
                               placeholder="Escanee o digite" />
                    </div>

                </div>

                <div class="consulta-ayuda">
                    Digite artículo o código de barras y presione Enter.
                    Se mostrarán todos los códigos de barras del artículo.
                </div>

                <div id="mensajeConsulta"
                     class="consulta-mensaje"></div>

                <div id="resultadoConsulta"
                     class="consulta-resultado d-none">

                    <div class="consulta-articulo">
                        <div id="resultadoArticuloCodigo"
                             class="consulta-articulo-codigo"></div>

                        <div id="resultadoArticuloDescripcion"
                             class="consulta-articulo-descripcion"></div>
                    </div>

                    <div class="consulta-titulo-lista">
                        Códigos de barras
                    </div>

                    <div id="listaCodigosBarras"
                         class="consulta-codigos"></div>

                </div>

            </div>
        </div>
    </div>

</div>

<div class="modal fade"
     id="modalEliminarCodigoBarras"
     tabindex="-1"
     aria-labelledby="modalEliminarCodigoBarrasLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header py-2">
                <h6 class="modal-title"
                    id="modalEliminarCodigoBarrasLabel">
                    Eliminar código
                </h6>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar"></button>
            </div>

            <div class="modal-body py-2">
                <div class="small mb-1">
                    Artículo:
                    <strong id="modalArticulo"></strong>
                </div>

                <div class="small">
                    Código:
                    <strong id="modalCodigoBarras"></strong>
                </div>

                <div class="small text-danger mt-2">
                    ¿Desea eliminar este registro?
                </div>
            </div>

            <div class="modal-footer py-2">
                <button type="button"
                        class="btn btn-sm btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        id="btnConfirmarEliminar"
                        class="btn btn-sm btn-danger">
                    Eliminar
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const urlValidar =
                '@Url.Action("ValidarArticulo", "TomaFisica")';

            const urlGuardar =
                '@Url.Action("GuardarCodigoBarras", "TomaFisica")';

            const urlConsultar =
                '@Url.Action("Consultar", "TomaFisica")';

            const urlEliminar =
                '@Url.Action("EliminarCodigoBarras", "TomaFisica")';

            const token =
                document.querySelector(
                    '#formAntiforgery input[name="__RequestVerificationToken"]'
                )?.value ?? '';

            const btnVentanaAgregar =
                document.getElementById('btnVentanaAgregar');

            const btnVentanaConsultar =
                document.getElementById('btnVentanaConsultar');

            const panelAgregar =
                document.getElementById('panelAgregar');

            const panelConsultar =
                document.getElementById('panelConsultar');

            const contenedor =
                document.getElementById('contenedorFilas');

            const contador =
                document.getElementById('contadorGuardados');

            const consultaArticulo =
                document.getElementById('consultaArticulo');

            const consultaCodigoBarras =
                document.getElementById('consultaCodigoBarras');

            const mensajeConsulta =
                document.getElementById('mensajeConsulta');

            const resultadoConsulta =
                document.getElementById('resultadoConsulta');

            const resultadoArticuloCodigo =
                document.getElementById('resultadoArticuloCodigo');

            const resultadoArticuloDescripcion =
                document.getElementById('resultadoArticuloDescripcion');

            const listaCodigosBarras =
                document.getElementById('listaCodigosBarras');

            let numeroFila = 0;
            let totalGuardados = 0;
            let articuloConsultado = '';
            let codigoSeleccionadoEliminar = '';

            function mostrarVentana(nombre) {
                const agregar = nombre === 'agregar';

                panelAgregar.classList.toggle('d-none', !agregar);
                panelConsultar.classList.toggle('d-none', agregar);

                btnVentanaAgregar.classList.toggle('activo', agregar);
                btnVentanaConsultar.classList.toggle('activo', !agregar);

                requestAnimationFrame(() => {
                    if (agregar) {
                        const ultimoArticulo =
                            contenedor.querySelector(
                                '.captura-fila:last-child .codigo-articulo');

                        ultimoArticulo?.focus();
                    }
                    else {
                        consultaArticulo.focus();
                    }
                });
            }

            btnVentanaAgregar.addEventListener(
                'click',
                () => mostrarVentana('agregar'));

            btnVentanaConsultar.addEventListener(
                'click',
                () => mostrarVentana('consultar'));

            function actualizarContador() {
                contador.textContent =
                    `Guardados: ${totalGuardados}`;
            }

            function mostrarMensaje(
                fila,
                mensaje,
                tipo = '') {

                const elemento =
                    fila.querySelector('.mensaje-fila');

                elemento.textContent = mensaje ?? '';
                elemento.classList.remove('error', 'ok');

                if (tipo)
                    elemento.classList.add(tipo);
            }

            function bloquearFilaGuardada(fila) {
                const articulo =
                    fila.querySelector('.codigo-articulo');

                const barras =
                    fila.querySelector('.codigo-barras');

                articulo.readOnly = true;
                barras.readOnly = true;
                barras.disabled = false;

                fila.classList.add('guardada');
                fila.dataset.guardada = '1';

                mostrarMensaje(
                    fila,
                    'Guardado correctamente.',
                    'ok');
            }

            async function validarArticulo(fila) {
                if (fila.dataset.guardada === '1')
                    return;

                if (fila.dataset.validando === '1')
                    return;

                const inputArticulo =
                    fila.querySelector('.codigo-articulo');

                const inputDescripcion =
                    fila.querySelector('.descripcion-articulo');

                const inputBarras =
                    fila.querySelector('.codigo-barras');

                const codigo = inputArticulo.value.trim();

                if (!codigo) {
                    mostrarMensaje(
                        fila,
                        'Digite el código del artículo.',
                        'error');

                    inputArticulo.focus();
                    return;
                }

                fila.dataset.validando = '1';
                mostrarMensaje(fila, 'Validando...');

                try {
                    const respuesta = await fetch(
                        `${urlValidar}?codigo=${encodeURIComponent(codigo)}`,
                        {
                            method: 'GET',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                    let datos = null;

                    try {
                        datos = await respuesta.json();
                    }
                    catch {
                        datos = null;
                    }

                    if (!respuesta.ok || !datos?.ok) {
                        fila.dataset.articuloValido = '0';

                        inputDescripcion.value = '';
                        inputDescripcion.title = '';
                        inputBarras.value = '';
                        inputBarras.disabled = true;

                        mostrarMensaje(
                            fila,
                            datos?.mensaje ??
                                'No fue posible validar el artículo.',
                            'error');

                        inputArticulo.focus();
                        inputArticulo.select();
                        return;
                    }

                    fila.dataset.articuloValido = '1';

                    inputArticulo.value =
                        datos.codigo ?? codigo;

                    inputDescripcion.value =
                        datos.descripcion ?? '';

                    inputDescripcion.title =
                        datos.descripcion ?? '';

                    inputBarras.disabled = false;

                    mostrarMensaje(
                        fila,
                        'Artículo válido.',
                        'ok');

                    inputBarras.focus();
                    inputBarras.select();
                }
                catch {
                    fila.dataset.articuloValido = '0';
                    inputBarras.disabled = true;

                    mostrarMensaje(
                        fila,
                        'Error al validar.',
                        'error');

                    inputArticulo.focus();
                    inputArticulo.select();
                }
                finally {
                    fila.dataset.validando = '0';
                }
            }

            async function guardarCodigoBarras(fila) {
                if (fila.dataset.guardada === '1')
                    return;

                if (fila.dataset.guardando === '1')
                    return;

                const inputArticulo =
                    fila.querySelector('.codigo-articulo');

                const inputDescripcion =
                    fila.querySelector('.descripcion-articulo');

                const inputBarras =
                    fila.querySelector('.codigo-barras');

                if (fila.dataset.articuloValido !== '1') {
                    await validarArticulo(fila);

                    if (fila.dataset.articuloValido !== '1')
                        return;
                }

                const codigoArticulo =
                    inputArticulo.value.trim();

                const codigoBarras =
                    inputBarras.value.trim();

                if (!codigoBarras) {
                    mostrarMensaje(
                        fila,
                        'Escanee el código de barras.',
                        'error');

                    inputBarras.focus();
                    return;
                }

                fila.dataset.guardando = '1';

                inputArticulo.readOnly = true;
                inputBarras.readOnly = true;

                mostrarMensaje(fila, 'Guardando...');

                try {
                    const cuerpo = new URLSearchParams();

                    cuerpo.append(
                        '__RequestVerificationToken',
                        token);

                    cuerpo.append(
                        'codigoArticulo',
                        codigoArticulo);

                    cuerpo.append(
                        'codigoBarras',
                        codigoBarras);

                    const respuesta = await fetch(
                        urlGuardar,
                        {
                            method: 'POST',
                            headers: {
                                'Content-Type':
                                    'application/x-www-form-urlencoded; charset=UTF-8',
                                'X-Requested-With':
                                    'XMLHttpRequest'
                            },
                            body: cuerpo.toString()
                        });

                    let datos = null;

                    try {
                        datos = await respuesta.json();
                    }
                    catch {
                        datos = null;
                    }

                    if (!respuesta.ok || !datos?.ok) {
                        inputArticulo.readOnly = false;
                        inputBarras.readOnly = false;

                        mostrarMensaje(
                            fila,
                            datos?.mensaje ??
                                'No fue posible guardar el código de barras.',
                            'error');

                        inputBarras.focus();
                        inputBarras.select();
                        return;
                    }

                    inputArticulo.value =
                        datos.codigoArticulo ??
                        codigoArticulo;

                    inputDescripcion.value =
                        datos.descripcion ??
                        inputDescripcion.value;

                    inputDescripcion.title =
                        inputDescripcion.value;

                    inputBarras.value =
                        datos.codigoBarras ??
                        codigoBarras;

                    bloquearFilaGuardada(fila);

                    totalGuardados++;
                    actualizarContador();

                    agregarFila();
                }
                catch {
                    inputArticulo.readOnly = false;
                    inputBarras.readOnly = false;

                    mostrarMensaje(
                        fila,
                        'Error al guardar.',
                        'error');

                    inputBarras.focus();
                    inputBarras.select();
                }
                finally {
                    fila.dataset.guardando = '0';
                }
            }

            function agregarFila() {
                numeroFila++;

                const fila =
                    document.createElement('div');

                fila.className = 'captura-fila';
                fila.dataset.articuloValido = '0';
                fila.dataset.guardada = '0';
                fila.dataset.validando = '0';
                fila.dataset.guardando = '0';

                const gridPrincipal =
                    document.createElement('div');

                gridPrincipal.className =
                    'captura-grid-principal';

                const grupoArticulo =
                    document.createElement('div');

                const inputArticulo =
                    document.createElement('input');

                inputArticulo.type = 'text';
                inputArticulo.className =
                    'form-control codigo-articulo';

                inputArticulo.maxLength = 20;
                inputArticulo.autocomplete = 'off';
                inputArticulo.autocapitalize = 'characters';
                inputArticulo.spellcheck = false;
                inputArticulo.enterKeyHint = 'next';
                inputArticulo.placeholder = `Art. ${numeroFila}`;

                inputArticulo.addEventListener(
                    'input',
                    () => {
                        if (fila.dataset.guardada === '1')
                            return;

                        fila.dataset.articuloValido = '0';

                        const descripcion =
                            fila.querySelector('.descripcion-articulo');

                        const barras =
                            fila.querySelector('.codigo-barras');

                        descripcion.value = '';
                        descripcion.title = '';
                        barras.value = '';
                        barras.disabled = true;

                        mostrarMensaje(fila, '');
                    });

                inputArticulo.addEventListener(
                    'keydown',
                    async event => {
                        if (event.key !== 'Enter')
                            return;

                        event.preventDefault();
                        await validarArticulo(fila);
                    });

                grupoArticulo.appendChild(inputArticulo);

                const grupoBarras =
                    document.createElement('div');

                const inputBarras =
                    document.createElement('input');

                inputBarras.type = 'text';
                inputBarras.className =
                    'form-control codigo-barras';

                inputBarras.maxLength = 25;
                inputBarras.autocomplete = 'off';
                inputBarras.spellcheck = false;
                inputBarras.enterKeyHint = 'done';
                inputBarras.disabled = true;

                inputBarras.addEventListener(
                    'keydown',
                    async event => {
                        if (event.key !== 'Enter')
                            return;

                        event.preventDefault();
                        await guardarCodigoBarras(fila);
                    });

                grupoBarras.appendChild(inputBarras);

                gridPrincipal.appendChild(grupoArticulo);
                gridPrincipal.appendChild(grupoBarras);

                const grupoDescripcion =
                    document.createElement('div');

                grupoDescripcion.className =
                    'captura-descripcion';

                const inputDescripcion =
                    document.createElement('input');

                inputDescripcion.type = 'text';
                inputDescripcion.className =
                    'form-control descripcion-articulo';

                inputDescripcion.readOnly = true;
                inputDescripcion.tabIndex = -1;
                inputDescripcion.placeholder =
                    'Nombre del artículo';

                grupoDescripcion.appendChild(inputDescripcion);

                const mensaje =
                    document.createElement('div');

                mensaje.className = 'mensaje-fila';

                fila.appendChild(gridPrincipal);
                fila.appendChild(grupoDescripcion);
                fila.appendChild(mensaje);

                contenedor.appendChild(fila);

                requestAnimationFrame(() => {
                    fila.scrollIntoView({
                        behavior: 'smooth',
                        block: 'nearest'
                    });

                    inputArticulo.focus();
                });
            }

            function limpiarResultadoConsulta() {
                resultadoConsulta.classList.add('d-none');

                resultadoArticuloCodigo.textContent = '';
                resultadoArticuloDescripcion.textContent = '';
                resultadoArticuloDescripcion.title = '';
                listaCodigosBarras.innerHTML = '';

                articuloConsultado = '';
            }

            function mostrarMensajeConsulta(
                mensaje,
                tipo = '') {

                mensajeConsulta.textContent =
                    mensaje ?? '';

                mensajeConsulta.classList.remove(
                    'error',
                    'ok');

                if (tipo)
                    mensajeConsulta.classList.add(tipo);
            }

            consultaArticulo.addEventListener(
                'input',
                () => {
                    if (consultaArticulo.value.trim()) {
                        consultaCodigoBarras.value = '';
                    }

                    limpiarResultadoConsulta();
                    mostrarMensajeConsulta('');
                });

            consultaCodigoBarras.addEventListener(
                'input',
                () => {
                    if (consultaCodigoBarras.value.trim()) {
                        consultaArticulo.value = '';
                    }

                    limpiarResultadoConsulta();
                    mostrarMensajeConsulta('');
                });

            async function consultarRegistros() {
                const articulo =
                    consultaArticulo.value.trim();

                const barras =
                    consultaCodigoBarras.value.trim();

                if (!articulo && !barras) {
                    mostrarMensajeConsulta(
                        'Digite artículo o código de barras.',
                        'error');

                    consultaArticulo.focus();
                    return;
                }

                mostrarMensajeConsulta('Consultando...');
                limpiarResultadoConsulta();

                const parametros = new URLSearchParams();

                if (articulo) {
                    parametros.append(
                        'codigoArticulo',
                        articulo);
                }

                if (barras) {
                    parametros.append(
                        'codigoBarras',
                        barras);
                }

                try {
                    const respuesta = await fetch(
                        `${urlConsultar}?${parametros.toString()}`,
                        {
                            method: 'GET',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                    let datos = null;

                    try {
                        datos = await respuesta.json();
                    }
                    catch {
                        datos = null;
                    }

                    if (!respuesta.ok || !datos?.ok) {
                        mostrarMensajeConsulta(
                            datos?.mensaje ??
                                'No se encontraron registros.',
                            'error');

                        return;
                    }

                    articuloConsultado =
                        datos.codigoArticulo ?? '';

                    /*
                     * Si se buscó por barcode, dejamos el artículo como
                     * búsqueda activa. Así, después de eliminar un barcode,
                     * podemos refrescar todos los restantes de ese artículo.
                     */
                    consultaArticulo.value =
                        articuloConsultado;

                    consultaCodigoBarras.value = '';

                    resultadoArticuloCodigo.textContent =
                        articuloConsultado;

                    resultadoArticuloDescripcion.textContent =
                        datos.descripcion ?? '';

                    resultadoArticuloDescripcion.title =
                        datos.descripcion ?? '';

                    listaCodigosBarras.innerHTML = '';

                    const codigos =
                        Array.isArray(datos.codigosBarras)
                            ? datos.codigosBarras
                            : [];

                    if (codigos.length === 0) {
                        const vacio =
                            document.createElement('div');

                        vacio.className =
                            'sin-codigos';

                        vacio.textContent =
                            'Este artículo no tiene códigos de barras registrados.';

                        listaCodigosBarras.appendChild(vacio);
                    }
                    else {
                        codigos.forEach(registro => {
                            const codigo =
                                registro.codigoBarras ?? '';

                            const boton =
                                document.createElement('button');

                            boton.type = 'button';
                            boton.className =
                                'codigo-consulta-item';

                            const texto =
                                document.createElement('span');

                            texto.className =
                                'codigo-texto';

                            texto.textContent = codigo;

                            const eliminar =
                                document.createElement('span');

                            eliminar.className =
                                'codigo-eliminar';

                            eliminar.textContent =
                                'Eliminar';

                            boton.appendChild(texto);
                            boton.appendChild(eliminar);

                            boton.addEventListener(
                                'click',
                                () => abrirPopupEliminar(
                                    articuloConsultado,
                                    codigo));

                            listaCodigosBarras.appendChild(boton);
                        });
                    }

                    resultadoConsulta.classList.remove('d-none');

                    mostrarMensajeConsulta(
                        'Consulta realizada.',
                        'ok');
                }
                catch {
                    mostrarMensajeConsulta(
                        'Error de comunicación al consultar.',
                        'error');
                }
            }

            consultaArticulo.addEventListener(
                'keydown',
                async event => {
                    if (event.key !== 'Enter')
                        return;

                    event.preventDefault();
                    await consultarRegistros();
                });

            consultaCodigoBarras.addEventListener(
                'keydown',
                async event => {
                    if (event.key !== 'Enter')
                        return;

                    event.preventDefault();
                    await consultarRegistros();
                });

            const modalElemento =
                document.getElementById(
                    'modalEliminarCodigoBarras');

            const modalArticulo =
                document.getElementById('modalArticulo');

            const modalCodigoBarras =
                document.getElementById('modalCodigoBarras');

            const btnConfirmarEliminar =
                document.getElementById('btnConfirmarEliminar');

            function obtenerModalEliminar() {
                if (typeof bootstrap === 'undefined')
                    return null;

                return bootstrap.Modal.getOrCreateInstance(
                    modalElemento);
            }

            function abrirPopupEliminar(
                articulo,
                codigoBarras) {

                articuloConsultado = articulo ?? '';
                codigoSeleccionadoEliminar =
                    codigoBarras ?? '';

                modalArticulo.textContent =
                    articuloConsultado;

                modalCodigoBarras.textContent =
                    codigoSeleccionadoEliminar;

                const modal =
                    obtenerModalEliminar();

                if (modal) {
                    modal.show();
                    return;
                }

                if (confirm(
                    `¿Eliminar ${codigoSeleccionadoEliminar}?`)) {
                    eliminarCodigoSeleccionado();
                }
            }

            async function eliminarCodigoSeleccionado() {
                if (!articuloConsultado ||
                    !codigoSeleccionadoEliminar) {
                    return;
                }

                btnConfirmarEliminar.disabled = true;
                btnConfirmarEliminar.textContent =
                    'Eliminando...';

                const cuerpo =
                    new URLSearchParams();

                cuerpo.append(
                    '__RequestVerificationToken',
                    token);

                cuerpo.append(
                    'codigoArticulo',
                    articuloConsultado);

                cuerpo.append(
                    'codigoBarras',
                    codigoSeleccionadoEliminar);

                try {
                    const respuesta = await fetch(
                        urlEliminar,
                        {
                            method: 'POST',
                            headers: {
                                'Content-Type':
                                    'application/x-www-form-urlencoded; charset=UTF-8',
                                'X-Requested-With':
                                    'XMLHttpRequest'
                            },
                            body: cuerpo.toString()
                        });

                    let datos = null;

                    try {
                        datos = await respuesta.json();
                    }
                    catch {
                        datos = null;
                    }

                    if (!respuesta.ok || !datos?.ok) {
                        mostrarMensajeConsulta(
                            datos?.mensaje ??
                                'No fue posible eliminar el código.',
                            'error');

                        return;
                    }

                    obtenerModalEliminar()?.hide();

                    codigoSeleccionadoEliminar = '';

                    consultaArticulo.value =
                        articuloConsultado;

                    consultaCodigoBarras.value = '';

                    await consultarRegistros();
                }
                catch {
                    mostrarMensajeConsulta(
                        'Error de comunicación al eliminar.',
                        'error');
                }
                finally {
                    btnConfirmarEliminar.disabled = false;
                    btnConfirmarEliminar.textContent =
                        'Eliminar';
                }
            }

            btnConfirmarEliminar.addEventListener(
                'click',
                eliminarCodigoSeleccionado);

            agregarFila();
            mostrarVentana('agregar');
        })();
    </script>
}
