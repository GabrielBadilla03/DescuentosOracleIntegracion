@{
    ViewData["Title"] = "Registro de códigos de barras";
}

<style>
    .toma-page {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto 24px auto;
        padding: 0 4px;
    }

    .toma-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, .06);
        overflow: hidden;
    }

        .toma-card .card-body {
            padding: 10px;
        }

    .toma-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
    }

        .toma-header h2 {
            margin: 0;
            font-size: 1.15rem;
        }

    .instruccion {
        font-size: .78rem;
        line-height: 1.25;
    }

    .contador {
        min-width: 95px;
        text-align: center;
        font-size: .75rem;
        font-weight: 700;
        white-space: nowrap;
    }

    /*
         * Primera línea de cada registro:
         * Código artículo | Código de barras
         */
    .captura-encabezado,
    .captura-grid-principal {
        display: grid;
        grid-template-columns: minmax(105px, 1fr) minmax(145px, 1.35fr);
        gap: 2px;
        width: 100%;
        align-items: center;
    }

    .captura-encabezado {
        padding: 0 2px 4px 2px;
        color: #495057;
        font-size: .69rem;
        font-weight: 700;
    }

        .captura-encabezado > div {
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    #contenedorFilas {
        width: 100%;
    }

    .captura-fila {
        padding: 4px 2px;
        margin: 0;
        border-top: 1px solid #e5e7eb;
        background: #fff;
        transition: background-color .12s ease-in-out;
    }

        .captura-fila:last-child {
            border-bottom: 1px solid #e5e7eb;
        }

        .captura-fila.guardada {
            background: #f0faf4;
        }

    .captura-grid-principal > div {
        min-width: 0;
    }

    /*
         * Segunda línea:
         * descripción a todo lo ancho.
         */
    .captura-descripcion {
        width: 100%;
        margin-top: 2px;
    }

    .captura-fila .form-control {
        width: 100%;
        min-width: 0;
        height: 38px;
        min-height: 38px;
        padding: 4px 5px;
        border-radius: 3px;
        font-size: 16px;
        line-height: 1.1;
    }

    .codigo-articulo {
        text-transform: uppercase;
    }

    .descripcion-articulo {
        width: 100% !important;
        background-color: #f8f9fa !important;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .codigo-barras {
        padding-left: 4px !important;
        padding-right: 4px !important;
    }

    .mensaje-fila {
        min-height: 0;
        margin-top: 2px;
        padding-left: 2px;
        font-size: .68rem;
        line-height: 1.15;
    }

        .mensaje-fila:empty {
            display: none;
        }

        .mensaje-fila.error {
            display: block;
            color: #dc3545;
            font-weight: 600;
        }

        .mensaje-fila.ok {
            display: block;
            color: #198754;
            font-weight: 600;
        }

    /*
         * En handheld las dos columnas superiores siguen siempre horizontales.
         * Solo se compactan espacios.
         */
    @@media (max-width: 767.98px) {
        .toma-page {
            padding: 0 1px;
            margin-bottom: 12px;
        }

        .toma-card {
            border-radius: 4px;
        }

            .toma-card .card-body {
                padding: 5px 3px;
            }

        .toma-header {
            margin-bottom: 6px;
        }

            .toma-header h2 {
                font-size: .95rem;
            }

        .instruccion {
            font-size: .68rem;
        }

        .toma-header .btn {
            padding: 4px 7px;
            font-size: .72rem;
            white-space: nowrap;
        }

        .captura-encabezado,
        .captura-grid-principal {
            grid-template-columns: minmax(100px, .95fr) minmax(140px, 1.30fr);
            gap: 1px;
        }

        .captura-encabezado {
            padding-left: 1px;
            padding-right: 1px;
            font-size: .62rem;
        }

        .captura-fila {
            padding: 3px 1px;
        }

            .captura-fila .form-control {
                height: 37px;
                min-height: 37px;
                padding: 3px 4px;
                border-radius: 2px;
                font-size: 16px;
            }

        .captura-descripcion {
            margin-top: 1px;
        }

        .mensaje-fila {
            font-size: .62rem;
            margin-top: 1px;
        }

        .contador {
            min-width: 82px;
            font-size: .67rem;
        }
    }

    @@media (max-width: 390px) {
        .captura-encabezado,
        .captura-grid-principal {
            grid-template-columns: minmax(92px, .9fr) minmax(132px, 1.25fr);
        }

        .toma-card .card-body {
            padding-left: 2px;
            padding-right: 2px;
        }
    }
</style>

<div class="toma-page">
    <div class="toma-header">
        <div>
            <h2>Registro de códigos de barras</h2>
            <div class="text-muted instruccion">
                Artículo → Enter → código de barras → Enter.
            </div>
        </div>

        <a asp-controller="ReportesCobros"
           asp-action="ResumenCobrosAgente"
           class="btn btn-outline-secondary btn-sm">
            Volver
        </a>
    </div>

    <div class="card toma-card">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                <div class="small text-muted instruccion">
                    Se guarda automáticamente al escanear.
                </div>

                <div id="contadorGuardados"
                     class="badge bg-success contador">
                    Guardados: 0
                </div>
            </div>

            <form id="formAntiforgery" class="d-none">
                @Html.AntiForgeryToken()
            </form>

            <div class="captura-encabezado">
                <div>Artículo</div>
                <div>Código barras</div>
            </div>

            <div id="contenedorFilas"></div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const urlValidar =
                '@Url.Action("ValidarArticulo", "TomaFisica")';

            const urlGuardar =
                '@Url.Action("GuardarCodigoBarras", "TomaFisica")';

            const token =
                document.querySelector(
                    '#formAntiforgery input[name="__RequestVerificationToken"]'
                )?.value ?? '';

            const contenedor =
                document.getElementById('contenedorFilas');

            const contador =
                document.getElementById('contadorGuardados');

            let numeroFila = 0;
            let totalGuardados = 0;

            function actualizarContador() {
                contador.textContent =
                    `Guardados: ${totalGuardados}`;
            }

            function mostrarMensaje(
                fila,
                mensaje,
                tipo = '') {

                const elemento =
                    fila.querySelector('.mensaje-fila');

                elemento.textContent = mensaje ?? '';
                elemento.classList.remove('error', 'ok');

                if (tipo)
                    elemento.classList.add(tipo);
            }

            function bloquearFilaGuardada(fila) {
                const articulo =
                    fila.querySelector('.codigo-articulo');

                const barras =
                    fila.querySelector('.codigo-barras');

                articulo.readOnly = true;
                barras.readOnly = true;
                barras.disabled = false;

                fila.classList.add('guardada');
                fila.dataset.guardada = '1';

                mostrarMensaje(
                    fila,
                    'Guardado correctamente.',
                    'ok');
            }

            async function validarArticulo(fila) {
                if (fila.dataset.guardada === '1')
                    return;

                if (fila.dataset.validando === '1')
                    return;

                const inputArticulo =
                    fila.querySelector('.codigo-articulo');

                const inputDescripcion =
                    fila.querySelector('.descripcion-articulo');

                const inputBarras =
                    fila.querySelector('.codigo-barras');

                const codigo = inputArticulo.value.trim();

                if (!codigo) {
                    mostrarMensaje(
                        fila,
                        'Digite el código del artículo.',
                        'error');

                    inputArticulo.focus();
                    return;
                }

                fila.dataset.validando = '1';
                mostrarMensaje(
                    fila,
                    'Validando...');

                try {
                    const respuesta = await fetch(
                        `${urlValidar}?codigo=${encodeURIComponent(codigo)}`,
                        {
                            method: 'GET',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                    let datos = null;

                    try {
                        datos = await respuesta.json();
                    }
                    catch {
                        datos = null;
                    }

                    if (!respuesta.ok || !datos?.ok) {
                        fila.dataset.articuloValido = '0';

                        inputDescripcion.value = '';
                        inputDescripcion.title = '';
                        inputBarras.value = '';
                        inputBarras.disabled = true;

                        mostrarMensaje(
                            fila,
                            datos?.mensaje ??
                                'No fue posible validar el artículo.',
                            'error');

                        inputArticulo.focus();
                        inputArticulo.select();
                        return;
                    }

                    fila.dataset.articuloValido = '1';

                    inputArticulo.value =
                        datos.codigo ?? codigo;

                    inputDescripcion.value =
                        datos.descripcion ?? '';

                    inputDescripcion.title =
                        datos.descripcion ?? '';

                    inputBarras.disabled = false;

                    mostrarMensaje(
                        fila,
                        'Artículo válido.',
                        'ok');

                    inputBarras.focus();
                    inputBarras.select();
                }
                catch {
                    fila.dataset.articuloValido = '0';

                    inputBarras.disabled = true;

                    mostrarMensaje(
                        fila,
                        'Error al validar.',
                        'error');

                    inputArticulo.focus();
                    inputArticulo.select();
                }
                finally {
                    fila.dataset.validando = '0';
                }
            }

            async function guardarCodigoBarras(fila) {
                if (fila.dataset.guardada === '1')
                    return;

                if (fila.dataset.guardando === '1')
                    return;

                const inputArticulo =
                    fila.querySelector('.codigo-articulo');

                const inputDescripcion =
                    fila.querySelector('.descripcion-articulo');

                const inputBarras =
                    fila.querySelector('.codigo-barras');

                if (fila.dataset.articuloValido !== '1') {
                    await validarArticulo(fila);

                    if (fila.dataset.articuloValido !== '1')
                        return;
                }

                const codigoArticulo =
                    inputArticulo.value.trim();

                const codigoBarras =
                    inputBarras.value.trim();

                if (!codigoBarras) {
                    mostrarMensaje(
                        fila,
                        'Escanee el código de barras.',
                        'error');

                    inputBarras.focus();
                    return;
                }

                fila.dataset.guardando = '1';

                inputArticulo.readOnly = true;
                inputBarras.readOnly = true;

                mostrarMensaje(
                    fila,
                    'Guardando...');

                try {
                    const cuerpo = new URLSearchParams();

                    cuerpo.append(
                        '__RequestVerificationToken',
                        token);

                    cuerpo.append(
                        'codigoArticulo',
                        codigoArticulo);

                    cuerpo.append(
                        'codigoBarras',
                        codigoBarras);

                    const respuesta = await fetch(
                        urlGuardar,
                        {
                            method: 'POST',
                            headers: {
                                'Content-Type':
                                    'application/x-www-form-urlencoded; charset=UTF-8',
                                'X-Requested-With':
                                    'XMLHttpRequest'
                            },
                            body: cuerpo.toString()
                        });

                    let datos = null;

                    try {
                        datos = await respuesta.json();
                    }
                    catch {
                        datos = null;
                    }

                    if (!respuesta.ok || !datos?.ok) {
                        inputArticulo.readOnly = false;
                        inputBarras.readOnly = false;

                        mostrarMensaje(
                            fila,
                            datos?.mensaje ??
                                'No fue posible guardar el código de barras.',
                            'error');

                        inputBarras.focus();
                        inputBarras.select();
                        return;
                    }

                    inputArticulo.value =
                        datos.codigoArticulo ??
                        codigoArticulo;

                    inputDescripcion.value =
                        datos.descripcion ??
                        inputDescripcion.value;

                    inputDescripcion.title =
                        inputDescripcion.value;

                    inputBarras.value =
                        datos.codigoBarras ??
                        codigoBarras;

                    bloquearFilaGuardada(fila);

                    totalGuardados++;
                    actualizarContador();

                    agregarFila();
                }
                catch {
                    inputArticulo.readOnly = false;
                    inputBarras.readOnly = false;

                    mostrarMensaje(
                        fila,
                        'Error al guardar.',
                        'error');

                    inputBarras.focus();
                    inputBarras.select();
                }
                finally {
                    fila.dataset.guardando = '0';
                }
            }

            function agregarFila() {
                numeroFila++;

                const fila =
                    document.createElement('div');

                fila.className = 'captura-fila';
                fila.dataset.articuloValido = '0';
                fila.dataset.guardada = '0';
                fila.dataset.validando = '0';
                fila.dataset.guardando = '0';

                /*
                 * Primera línea:
                 * Artículo | Código de barras
                 */
                const gridPrincipal =
                    document.createElement('div');

                gridPrincipal.className =
                    'captura-grid-principal';

                const grupoArticulo =
                    document.createElement('div');

                const inputArticulo =
                    document.createElement('input');

                inputArticulo.type = 'text';
                inputArticulo.className =
                    'form-control codigo-articulo';

                inputArticulo.maxLength = 20;
                inputArticulo.autocomplete = 'off';
                inputArticulo.autocapitalize = 'characters';
                inputArticulo.spellcheck = false;
                inputArticulo.enterKeyHint = 'next';
                inputArticulo.placeholder = `Art. ${numeroFila}`;

                inputArticulo.addEventListener(
                    'input',
                    () => {
                        if (fila.dataset.guardada === '1')
                            return;

                        fila.dataset.articuloValido = '0';

                        const descripcion =
                            fila.querySelector('.descripcion-articulo');

                        const barras =
                            fila.querySelector('.codigo-barras');

                        descripcion.value = '';
                        descripcion.title = '';
                        barras.value = '';
                        barras.disabled = true;

                        mostrarMensaje(fila, '');
                    });

                inputArticulo.addEventListener(
                    'keydown',
                    async event => {
                        if (event.key !== 'Enter')
                            return;

                        event.preventDefault();
                        await validarArticulo(fila);
                    });

                grupoArticulo.appendChild(
                    inputArticulo);

                const grupoBarras =
                    document.createElement('div');

                const inputBarras =
                    document.createElement('input');

                inputBarras.type = 'text';
                inputBarras.className =
                    'form-control codigo-barras';

                inputBarras.maxLength = 25;
                inputBarras.autocomplete = 'off';
                inputBarras.spellcheck = false;
                inputBarras.enterKeyHint = 'done';
                inputBarras.disabled = true;

                inputBarras.addEventListener(
                    'keydown',
                    async event => {
                        if (event.key !== 'Enter')
                            return;

                        event.preventDefault();
                        await guardarCodigoBarras(fila);
                    });

                grupoBarras.appendChild(
                    inputBarras);

                gridPrincipal.appendChild(
                    grupoArticulo);

                gridPrincipal.appendChild(
                    grupoBarras);

                /*
                 * Segunda línea:
                 * descripción usando todo el ancho disponible.
                 */
                const grupoDescripcion =
                    document.createElement('div');

                grupoDescripcion.className =
                    'captura-descripcion';

                const inputDescripcion =
                    document.createElement('input');

                inputDescripcion.type = 'text';
                inputDescripcion.className =
                    'form-control descripcion-articulo';

                inputDescripcion.readOnly = true;
                inputDescripcion.tabIndex = -1;
                inputDescripcion.placeholder =
                    'Nombre del artículo';

                grupoDescripcion.appendChild(
                    inputDescripcion);

                const mensaje =
                    document.createElement('div');

                mensaje.className =
                    'mensaje-fila';

                fila.appendChild(
                    gridPrincipal);

                fila.appendChild(
                    grupoDescripcion);

                fila.appendChild(
                    mensaje);

                contenedor.appendChild(
                    fila);

                requestAnimationFrame(() => {
                    fila.scrollIntoView({
                        behavior: 'smooth',
                        block: 'nearest'
                    });

                    inputArticulo.focus();
                });
            }

            agregarFila();
        })();
    </script>
}
